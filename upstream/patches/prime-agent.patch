+	schemaSha256: string;
+	policy: "allow" | "approval" | "deny";
+}
+
+export interface ManagedPrimeManifest {
+	version: 2;
+	authorityDigest: string;
+	operationId: string;
+	turnId: string;
+	model: `openai-codex/${string}`;
+	session: { id: string; directory: "/run/prime/session"; resume: boolean };
+	harness: { maxSubagentDepth: 2; maxSubagents: 4 };
+	instruction: string;
+	prompt: string;
+	workspace: string;
+	deadlineAt: string;
+	mcp: Array<{ connectionId: string; tools: ManagedPrimeTool[] }>;
+	localTools: Array<{ name: "ipython"; policy: "workspace-write"; inputSchema: JsonObject; schemaSha256: string }>;
+	readPaths: string[];
+}
+
+export type ManagedPrimePayload =
+	| { method: "provider.catalog" }
+	| { method: "provider.stream"; turnId: string; request: unknown }
+	| { method: "provider.status" | "provider.abort" | "effect.status"; targetRequestId: string }
+	| { method: "mcp.tools.list"; connectionId: string }
+	| { method: "mcp.tools.call"; connectionId: string; tool: string; arguments: unknown }
+	| { method: "paperclip.request"; httpMethod: "GET" | "POST" | "PATCH" | "PUT"; path: string; body?: unknown }
+	| { method: "paperclip.finish"; status: "blocked" | "in_review" | "done"; summary: string }
+	| { method: "operation.stop" | "operation.status" };
+
+export type ManagedPrimeFrame =
+	| { version: 2; requestId: string; sequence: number; kind: "provider_event"; event: JsonObject }
+	| { version: 2; requestId: string; sequence: number; kind: "result"; result: JsonObject }
+	| { version: 2; requestId: string; sequence: number; kind: "error"; error: { code: string; message: string } };
+
+export class ManagedPrimeTransportError extends Error {
+	constructor(message: string) {
+		super(message);
+		this.name = "ManagedPrimeTransportError";
+	}
+}
+
+function record(value: unknown): value is JsonObject {
+	return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+function fields(value: JsonObject, expected: readonly string[]): boolean {
+	const keys = Object.keys(value);
+	return keys.length === expected.length && keys.every((key) => expected.includes(key));
+}
+
+function nonempty(value: unknown): value is string {
+	return typeof value === "string" && value.length > 0;
+}
+
+function validModel(value: unknown): value is `openai-codex/${string}` {
+	return typeof value === "string" && /^openai-codex\/[A-Za-z0-9][A-Za-z0-9._-]*$/.test(value);
+}
+
+/** The shared digest for JSON-compatible, recursively key-sorted tool schemas. */
+export function canonicalManagedSchemaDigest(value: unknown): string {
+	const plain: unknown = JSON.parse(JSON.stringify(value));
+	const canonical = (item: unknown): unknown => {
+		if (Array.isArray(item)) return item.map(canonical);
+		if (record(item)) {
+			return Object.fromEntries(
+				Object.keys(item)
+					.filter((key) => key !== "~kind" && key !== "~unsafe")
+					.sort()
+					.map((key) => [key, canonical(item[key])]),
+			);
+		}
+		return item;
+	};
+	return createHash("sha256")
+		.update(JSON.stringify(canonical(plain)), "utf8")
+		.digest("hex");
+}
+
+function parseManifest(value: unknown): ManagedPrimeManifest {
+	if (
+		!record(value) ||
+		!fields(value, [
+			"version",
+			"authorityDigest",
+			"operationId",
+			"turnId",
+			"model",
+			"session",
+			"harness",
+			"instruction",
+			"prompt",
+			"workspace",
+			"deadlineAt",
+			"mcp",
+			"localTools",
+			"readPaths",
+		]) ||
+		value.version !== 2 ||
+		typeof value.authorityDigest !== "string" ||
+		!/^[a-f0-9]{64}$/.test(value.authorityDigest) ||
+		!nonempty(value.operationId) ||
+		!nonempty(value.turnId) ||
+		!validModel(value.model) ||
+		!record(value.session) ||
+		!fields(value.session, ["id", "directory", "resume"]) ||
+		!nonempty(value.session.id) ||
+		!/^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(value.session.id) ||
+		value.session.directory !== "/run/prime/session" ||
+		typeof value.session.resume !== "boolean" ||
+		!record(value.harness) ||
+		!fields(value.harness, ["maxSubagentDepth", "maxSubagents"]) ||
+		value.harness.maxSubagentDepth !== 2 ||
+		value.harness.maxSubagents !== 4 ||
+		typeof value.instruction !== "string" ||
+		typeof value.prompt !== "string" ||
+		!nonempty(value.workspace) ||
+		!isAbsolute(value.workspace) ||
+		resolve(value.workspace) !== value.workspace ||
+		value.workspace === "/" ||
+		value.workspace.startsWith("/opt/paperclip/") ||
+		!nonempty(value.deadlineAt) ||
+		!Number.isFinite(Date.parse(value.deadlineAt)) ||
+		!Array.isArray(value.mcp) ||
+		!Array.isArray(value.localTools) ||
+		value.localTools.length !== 1 ||
+		!Array.isArray(value.readPaths)
+	) {
+		throw new ManagedPrimeTransportError("Invalid managed Prime manifest");
+	}
+	const localTool = value.localTools[0];
+	if (
+		!record(localTool) ||
+		!fields(localTool, ["name", "policy", "inputSchema", "schemaSha256"]) ||
+		localTool.name !== "ipython" ||
+		localTool.policy !== "workspace-write" ||
+		!record(localTool.inputSchema) ||
+		typeof localTool.schemaSha256 !== "string" ||
+		!/^[a-f0-9]{64}$/.test(localTool.schemaSha256)
+	) {
+		throw new ManagedPrimeTransportError("Invalid managed Prime local tool");
+	}
+	const expectedReadPaths = new Set([
+		value.workspace,
+		value.session.directory,
+		"/run/prime/session-artifacts",
+		"/opt/paperclip/managed-instructions.md",
+		"/opt/paperclip/runtime",
+	]);
+	const skillIndices: number[] = [];
+	const workspacePrefix = `${value.workspace}/`;
+	for (const path of value.readPaths) {
+		if (
+			typeof path !== "string" ||
+			!isAbsolute(path) ||
+			resolve(path) !== path ||
+			path.includes("//") ||
+			path.includes("\0")
+		) {
+			throw new ManagedPrimeTransportError("Invalid managed Prime read path");
+		}
+		if (expectedReadPaths.has(path) || path.startsWith(workspacePrefix)) continue;
+		const match = /^\/opt\/paperclip\/skills\/(0|[1-9]\d*)$/.exec(path);
+		if (!match) throw new ManagedPrimeTransportError("Unauthorized managed Prime read path");
+		const index = Number(match[1]);
+		if (!Number.isSafeInteger(index)) throw new ManagedPrimeTransportError("Invalid managed Prime skill path");
+		skillIndices.push(index);
+		expectedReadPaths.add(path);
+	}
+	const uniquePaths = new Set(value.readPaths);
+	if (
+		uniquePaths.size !== value.readPaths.length ||
+		!value.readPaths.includes(value.workspace) ||
+		!value.readPaths.includes("/opt/paperclip/managed-instructions.md") ||
+		!value.readPaths.includes("/opt/paperclip/runtime") ||
+		skillIndices.some((index) => index >= skillIndices.length)
+	) {
+		throw new ManagedPrimeTransportError("Invalid managed Prime read paths");
+	}
+	const connectionIds = new Set<string>();
+	for (const connection of value.mcp) {
+		if (
+			!record(connection) ||
+			!fields(connection, ["connectionId", "tools"]) ||
+			!nonempty(connection.connectionId) ||
+			!Array.isArray(connection.tools) ||
+			connectionIds.has(connection.connectionId)
+		) {
+			throw new ManagedPrimeTransportError("Invalid managed Prime MCP manifest");
+		}
+		connectionIds.add(connection.connectionId);
+		const toolNames = new Set<string>();
+		for (const tool of connection.tools) {
+			if (
+				!record(tool) ||
+				!fields(tool, ["name", "description", "inputSchema", "schemaSha256", "policy"]) ||
+				!nonempty(tool.name) ||
+				typeof tool.description !== "string" ||
+				!record(tool.inputSchema) ||
+				typeof tool.schemaSha256 !== "string" ||
+				!/^[a-f0-9]{64}$/.test(tool.schemaSha256) ||
+				!(["allow", "approval", "deny"] as unknown[]).includes(tool.policy) ||
+				toolNames.has(tool.name)
+			) {
+				throw new ManagedPrimeTransportError("Invalid managed Prime MCP tool");
+			}
+			toolNames.add(tool.name);
+		}
+	}
+	return value as unknown as ManagedPrimeManifest;
+}
+
+export async function loadManagedPrimeRuntime(manifestPath: string): Promise<ManagedPrimeRuntime> {
+	const handle = await open(manifestPath, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
+	try {
+		const stats = await handle.stat();
+		if (!stats.isFile() || stats.size > MAX_MANIFEST_BYTES) {
+			throw new ManagedPrimeTransportError("Invalid managed Prime manifest file");
+		}
+		const bytes = await handle.readFile();
+		if (bytes.length > MAX_MANIFEST_BYTES) {
+			throw new ManagedPrimeTransportError("Managed Prime manifest exceeds size limit");
+		}
+		return new ManagedPrimeRuntime(JSON.parse(bytes.toString("utf8")));
+	} finally {
+		await handle.close();
+	}
+}
+
+function checkPayload(payload: ManagedPrimePayload, manifest: ManagedPrimeManifest): void {
+	if (!record(payload)) throw new ManagedPrimeTransportError("Invalid managed Prime request");
+	switch (payload.method) {
+		case "provider.catalog":
+		case "operation.stop":
+		case "operation.status":
+			if (fields(payload, ["method"])) return;
+			break;
+		case "provider.stream":
+			if (
+				fields(payload, ["method", "turnId", "request"]) &&
+				payload.turnId === manifest.turnId &&
+				record(payload.request)
+			)
+				return;
+			break;
+		case "provider.status":
+		case "provider.abort":
+		case "effect.status":
+			if (fields(payload, ["method", "targetRequestId"]) && nonempty(payload.targetRequestId)) return;
+			break;
+		case "mcp.tools.list":
+			if (
+				fields(payload, ["method", "connectionId"]) &&
+				manifest.mcp.some((item) => item.connectionId === payload.connectionId)
+			)
+				return;
+			break;
+		case "mcp.tools.call":
+			if (
+				fields(payload, ["method", "connectionId", "tool", "arguments"]) &&
+				manifest.mcp.some(
+					(item) =>
+						item.connectionId === payload.connectionId &&
+						item.tools.some((tool) => tool.name === payload.tool && tool.policy !== "deny"),
+				)
+			)
+				return;
+			break;
+		case "paperclip.request": {
+			const path = payload.path;
+			if (
+				(fields(payload, ["method", "httpMethod", "path"]) ||
+					fields(payload, ["method", "httpMethod", "path", "body"])) &&
+				["GET", "POST", "PATCH", "PUT"].includes(payload.httpMethod) &&
+				typeof path === "string" &&
+				path.startsWith("/api/") &&
+				!/[\\#@\u0000-\u001f]/.test(path) &&
+				!path.includes("//") &&
+				!/%(?:2e|2f|5c|00)/i.test(path) &&
+				!path
+					.split("?")[0]
+					.split("/")
+					.some((part) => part === "." || part === "..")
+			)
+				return;
+			break;
+		}
+		case "paperclip.finish":
+			if (
+				fields(payload, ["method", "status", "summary"]) &&
+				["blocked", "in_review", "done"].includes(payload.status) &&
+				nonempty(payload.summary)
+			)
+				return;
+			break;
+	}
+	throw new ManagedPrimeTransportError("Unauthorized managed Prime request");
+}
+
+function parseFrame(line: Buffer, requestId: string, previousSequence: number): ManagedPrimeFrame {
+	let decoded: unknown;
+	try {
+		decoded = JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(line));
+	} catch {
+		throw new ManagedPrimeTransportError("Invalid managed Prime IPC frame");
+	}
+	if (
+		!record(decoded) ||
+		decoded.version !== 2 ||
+		decoded.requestId !== requestId ||
+		!Number.isSafeInteger(decoded.sequence) ||
+		(decoded.sequence as number) <= previousSequence
+	) {
+		throw new ManagedPrimeTransportError("Invalid managed Prime IPC frame identity or sequence");
+	}
+	if (
+		decoded.kind === "provider_event" &&
+		fields(decoded, ["version", "requestId", "sequence", "kind", "event"]) &&
+		record(decoded.event)
+	)
+		return decoded as ManagedPrimeFrame;
+	if (
+		decoded.kind === "result" &&
+		fields(decoded, ["version", "requestId", "sequence", "kind", "result"]) &&
+		record(decoded.result) &&
+		["catalog", "provider", "mcp_tools", "effect", "paperclip", "finalization", "operation", "reservation"].includes(
+			String(decoded.result.kind),
+		)
+	) {
+		if (
+			decoded.result.kind === "reservation" &&
+			(!["dispatching", "uncertain"].includes(String(decoded.result.state)) || !nonempty(decoded.result.method))
+		)
+			throw new ManagedPrimeTransportError("Invalid managed Prime reservation observation");
+		return decoded as ManagedPrimeFrame;
+	}
+	if (
+		decoded.kind === "error" &&
+		fields(decoded, ["version", "requestId", "sequence", "kind", "error"]) &&
+		record(decoded.error) &&
+		fields(decoded.error, ["code", "message"]) &&
+		nonempty(decoded.error.code) &&
+		typeof decoded.error.message === "string"
+	)
+		return decoded as ManagedPrimeFrame;
+	throw new ManagedPrimeTransportError("Invalid managed Prime IPC frame");
+}
+
+function terminalResponseId(event: JsonObject): string | undefined {
+	if (!["response.completed", "response.done", "response.incomplete", "response.failed"].includes(String(event.type)))
+		return;
+	const response = event.response;
+	return record(response) && nonempty(response.id) ? response.id : undefined;
+}
+
+/** Gate the real Codex parser's terminal event behind the broker's correlated receipt. */
+export function managedCodexTransport(runtime: ManagedPrimeRuntime): ManagedCodexTransport {
+	return {
+		model: runtime.manifest.model.slice(MODEL_PREFIX.length),
+		async *request(body, signal) {
+			let terminal: JsonObject | undefined;
+			let settled = false;
+			for await (const frame of runtime.requestProviderStream(body, signal)) {
+				if (frame.kind === "provider_event") {
+					if (terminal) throw new ManagedPrimeTransportError("Managed Codex event after terminal response");
+					if (
+						["response.done", "response.completed", "response.incomplete", "response.failed"].includes(
+							String(frame.event.type),
+						)
+					) {
+						terminal = frame.event;
+					} else {
+						yield frame.event;
+					}
+					continue;
+				}
+				if (frame.kind !== "result") throw new ManagedPrimeTransportError("Managed Codex broker error");
+				const response = terminal?.response;
+				if (
+					settled ||
+					frame.result.kind !== "provider" ||
+					frame.result.state !== "completed" ||
+					!terminal ||
+					(terminal.type !== "response.completed" && terminal.type !== "response.done") ||
+					!record(response) ||
+					response.status !== "completed" ||
+					!nonempty(response.id) ||
+					frame.result.providerRequestId !== response.id
+				) {
+					throw new ManagedPrimeTransportError("Managed Codex lacks authenticated completed settlement");
+				}
+				settled = true;
+			}
+			if (!settled || !terminal)
+				throw new ManagedPrimeTransportError("Managed Codex stream ended without authenticated settlement");
+			yield terminal;
+		},
+	};
+}
+
+export class ManagedPrimeRuntime {
+	private readonly pending = new Set<string>();
+	private readonly pendingWaiters = new Set<() => void>();
