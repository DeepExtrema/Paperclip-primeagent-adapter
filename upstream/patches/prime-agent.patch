+					partial = [];
+					partialBytes = 0;
+					offset = end + 1;
+					if (frame.kind === "error")
+						throw new ManagedPrimeTransportError(
+							`Managed Prime broker ${frame.error.code}: ${frame.error.message}`,
+						);
+					if (frame.kind === "provider_event") {
+						if (!isProvider && payload.method !== "provider.status" && payload.method !== "provider.abort")
+							throw new ManagedPrimeTransportError("Unexpected provider event in managed Prime response");
+						const created =
+							frame.event.type === "response.created" &&
+							record(frame.event.response) &&
+							nonempty(frame.event.response.id)
+								? frame.event.response.id
+								: undefined;
+						const priorTerminal = this.providerTerminals.get(targetRequestId);
+						if (priorTerminal && isProvider) {
+							throw new ManagedPrimeTransportError(
+								"Managed Prime provider event followed an authentic terminal",
+							);
+						}
+						if (created) {
+							const priorId = this.providerResponseIds.get(targetRequestId);
+							if (priorId && priorId !== created)
+								throw new ManagedPrimeTransportError("Managed Prime provider response identity changed");
+							this.providerResponseIds.set(targetRequestId, created);
+						}
+						const observedTerminal = terminalResponseId(frame.event);
+						if (observedTerminal) {
+							const createdId = this.providerResponseIds.get(targetRequestId);
+							if (createdId && createdId !== observedTerminal)
+								throw new ManagedPrimeTransportError("Managed Prime provider response identity mismatch");
+							const response = frame.event.response;
+							const status = record(response) ? response.status : undefined;
+							if (
+								priorTerminal &&
+								(priorTerminal.id !== observedTerminal ||
+									priorTerminal.type !== frame.event.type ||
+									priorTerminal.status !== status)
+							) {
+								throw new ManagedPrimeTransportError("Managed Prime provider terminal replay changed");
+							}
+							if (!priorTerminal)
+								this.providerTerminals.set(targetRequestId, {
+									id: observedTerminal,
+									type: frame.event.type,
+									status,
+								});
+						}
+						yield frame;
+						continue;
+					}
+					if (frame.result.kind === "reservation") {
+						throw new ManagedPrimeTransportError(
+							`Managed Prime ${frame.result.state} reservation; upstream settlement unknown`,
+						);
+					}
+					const expectedKind =
+						payload.method === "effect.status"
+							? {
+									mcp: "effect",
+									paperclip: "paperclip",
+									finalization: "finalization",
+									provider: "provider",
+								}[this.pendingKinds.get(targetRequestId)!]
+							: RESULT_KIND[payload.method];
+					if (frame.result.kind !== expectedKind) {
+						throw new ManagedPrimeTransportError("Managed Prime IPC result does not match request method");
+					}
+					if (
+						isProvider ||
+						((payload.method === "provider.status" || payload.method === "provider.abort") &&
+							this.pending.has(targetRequestId))
+					) {
+						const terminal = this.providerTerminals.get(targetRequestId);
+						if (
+							terminal &&
+							frame.result.providerRequestId === terminal.id &&
+							((frame.result.state === "completed" &&
+								terminal.status === "completed" &&
+								(terminal.type === "response.completed" || terminal.type === "response.done")) ||
+								(frame.result.state === "aborted" &&
+									terminal.type === "response.done" &&
+									terminal.status === "cancelled") ||
+								(frame.result.state === "failed" &&
+									((terminal.type === "response.incomplete" && terminal.status === "incomplete") ||
+										(terminal.type === "response.failed" && terminal.status === "failed") ||
+										(terminal.type === "response.done" &&
+											(terminal.status === "failed" || terminal.status === "incomplete")))))
+						) {
+							this.settle(targetRequestId);
+						}
+					}
+					if (effectKind || payload.method === "effect.status") {
+						const kind = this.pendingKinds.get(targetRequestId);
+						const receipt = frame.result;
+						if (kind === "mcp" && receipt.kind === "effect") {
+							if (receipt.requestId !== targetRequestId || !nonempty(receipt.requestId))
+								throw new ManagedPrimeTransportError("Managed Prime MCP effect lacks correlated receipt");
+							if (receipt.state === "completed" || receipt.state === "failed") this.settle(targetRequestId);
+						} else if (kind === "paperclip" && receipt.kind === "paperclip") {
+							if (
+								!fields(receipt, ["kind", "requestId", "status", "body"]) ||
+								receipt.requestId !== targetRequestId ||
+								!Number.isInteger(receipt.status) ||
+								(receipt.status as number) < 200 ||
+								(receipt.status as number) > 299
+							)
+								throw new ManagedPrimeTransportError("Managed Prime Paperclip effect lacks correlated receipt");
+							this.settle(targetRequestId);
+						} else if (kind === "finalization" && receipt.kind === "finalization") {
+							const intent = this.finishIntents.get(targetRequestId);
+							if (
+								!fields(receipt, ["kind", "intentId", "issueId", "status", "summary", "state"]) ||
+								receipt.intentId !== targetRequestId ||
+								!nonempty(receipt.issueId) ||
+								receipt.state !== "recorded" ||
+								!intent ||
+								receipt.status !== intent.status ||
+								receipt.summary !== intent.summary
+							)
+								throw new ManagedPrimeTransportError("Managed Prime finalization lacks correlated receipt");
+							this.settle(targetRequestId);
+						}
+					}
+					finished = true;
+					yield frame;
+					if (offset !== bytes.length || partialBytes !== 0)
+						throw new ManagedPrimeTransportError("Unexpected managed Prime response after result");
+				}
+			}
+			if (partialBytes > 0 || !finished)
+				throw new ManagedPrimeTransportError("Managed Prime IPC closed without a complete result");
+		} catch (error) {
+			if (error instanceof ManagedPrimeTransportError) throw error;
+			throw new ManagedPrimeTransportError("Managed Prime IPC transport failed; upstream settlement unknown");
+		} finally {
+			signal?.removeEventListener("abort", abort);
+			socket.destroy();
+		}
+	}
+}
diff --git 1/packages/coding-agent/src/core/managed-prime-tools.ts 2/packages/coding-agent/src/core/managed-prime-tools.ts
new file mode 100644
index 0000000..e091953
--- /dev/null
+++ 2/packages/coding-agent/src/core/managed-prime-tools.ts
@@ -0,0 +1,132 @@
+import { createHash } from "node:crypto";
+import { setTimeout as delay } from "node:timers/promises";
+import type { TSchema } from "typebox";
+import type { ToolDefinition } from "./extensions/index.js";
+import {
+	canonicalManagedSchemaDigest,
+	type ManagedPrimeFrame,
+	type ManagedPrimePayload,
+	type ManagedPrimeRuntime,
+} from "./managed-prime-runtime.js";
+
+/** Derive native tool implementations exclusively from the operation's pinned metadata. */
+export function createManagedMcpTools(runtime: ManagedPrimeRuntime): ToolDefinition[] {
+	const tools: ToolDefinition[] = [];
+	const names = new Set<string>();
+	for (const connection of runtime.manifest.mcp) {
+		for (const tool of connection.tools) {
+			if (tool.policy === "deny") continue;
+			if (canonicalManagedSchemaDigest(tool.inputSchema) !== tool.schemaSha256) {
+				throw new Error("Managed MCP tool schema does not match its pinned digest");
+			}
+			const name = `mcp_${createHash("sha256").update(connection.connectionId).update("\0").update(tool.name).digest("hex").slice(0, 32)}`;
+			if (names.has(name)) throw new Error("Managed MCP tool identity collision");
+			names.add(name);
+			tools.push({
+				name,
+				label: tool.name,
+				description: tool.description,
+				parameters: tool.inputSchema as TSchema,
+				// One governed effect owns the operation until its authoritative result.
+				executionMode: "sequential",
+				async execute(_toolCallId, args, signal) {
+					const observe = async (
+						frames: AsyncIterable<ManagedPrimeFrame>,
+						originalRequestId?: string,
+					): Promise<Record<string, unknown>> => {
+						let receipt: Record<string, unknown> | undefined;
+						for await (const frame of frames) {
+							if (
+								frame.kind !== "result" ||
+								frame.result.kind !== "effect" ||
+								receipt ||
+								frame.result.requestId !== (originalRequestId ?? frame.requestId)
+							) {
+								throw new Error("Managed MCP effect has no correlated authority receipt");
+							}
+							receipt = frame.result;
+						}
+						if (!receipt) throw new Error("Managed MCP effect ended without an authority receipt");
+						return receipt;
+					};
+					let receipt = await observe(
+						runtime.request(
+							{
+								method: "mcp.tools.call",
+								connectionId: connection.connectionId,
+								tool: tool.name,
+								arguments: args,
+							},
+							signal,
+						),
+					);
+					const originalRequestId = receipt.requestId as string;
+					while (receipt.state === "awaiting_approval") {
+						// Foreground original-effect observation, never tool redispatch. Keep
+						// control reads available after cancellation so stop can close it.
+						await delay(1_000);
+						receipt = await observe(
+							runtime.request({ method: "effect.status", targetRequestId: originalRequestId }),
+							originalRequestId,
+						);
+					}
+					if (receipt.state !== "completed")
+						throw new Error("Managed MCP effect has no authoritative completed receipt");
+					return {
+						content: [{ type: "text" as const, text: JSON.stringify(receipt.result) }],
+						details: receipt,
+					};
+				},
+			});
+		}
+	}
+	return tools;
+}
+
+export interface ManagedPaperclipResult {
+	kind: "paperclip";
+	requestId: string;
+	status: number;
+	body: unknown;
+}
+
+export interface ManagedFinalizationResult {
+	kind: "finalization";
+	intentId: string;
+	issueId: string;
+	status: "blocked" | "in_review" | "done";
+	summary: string;
+	state: "recorded";
+}
+
+/** Dispatch once; only the broker's correlated, settled receipt may complete this call. */
+export async function managedPaperclipRequest(
+	runtime: ManagedPrimeRuntime,
+	input: Omit<Extract<ManagedPrimePayload, { method: "paperclip.request" }>, "method">,
+	signal?: AbortSignal,
+): Promise<ManagedPaperclipResult> {
+	let receipt: ManagedPaperclipResult | undefined;
+	for await (const frame of runtime.request({ method: "paperclip.request", ...input }, signal)) {
+		if (frame.kind !== "result" || frame.result.kind !== "paperclip" || receipt)
+			throw new Error("Managed Paperclip request lacks authoritative settlement");
+		receipt = frame.result as unknown as ManagedPaperclipResult;
+	}
+	if (!receipt) throw new Error("Managed Paperclip request ended without a receipt");
+	return receipt;
+}
+
+/** Record a trusted finalization intent, never mutate issue status from the worker. */
+export async function managedPaperclipFinish(
+	runtime: ManagedPrimeRuntime,
+	input: Omit<Extract<ManagedPrimePayload, { method: "paperclip.finish" }>, "method">,
+	signal?: AbortSignal,
+): Promise<ManagedFinalizationResult> {
+	let receipt: ManagedFinalizationResult | undefined;
+	for await (const frame of runtime.request({ method: "paperclip.finish", ...input }, signal)) {
+		if (frame.kind !== "result" || frame.result.kind !== "finalization" || receipt)
+			throw new Error("Managed Paperclip finalization lacks authoritative settlement");
+		receipt = frame.result as unknown as ManagedFinalizationResult;
+	}
+	if (!receipt) throw new Error("Managed Paperclip finalization ended without a receipt");
+	return receipt;
+}
diff --git 1/packages/coding-agent/test/managed-prime-runtime.test.ts 2/packages/coding-agent/test/managed-prime-runtime.test.ts
