+	private readonly providerTerminals = new Map<string, { id: string; type: unknown; status: unknown }>();
+	private readonly pendingKinds = new Map<string, "provider" | "mcp" | "paperclip" | "finalization">();
+	private readonly finishIntents = new Map<string, { status: string; summary: string }>();
