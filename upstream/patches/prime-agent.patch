+"""Managed Paperclip operations through the typed Prime host bridge."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from . import host_request
+
+
+_MISSING = object()
+
+async def request(http_method: str, path: str, body: Any = _MISSING) -> dict[str, Any]:
+    """Perform one governed, issue-scoped Paperclip API request."""
+    if http_method not in {"GET", "POST", "PATCH", "PUT"}:
+        raise ValueError("paperclip.request requires GET, POST, PATCH, or PUT")
+    if not isinstance(path, str) or not path.startswith("/api/"):
+        raise ValueError("paperclip.request requires an /api/-relative path")
+    payload: dict[str, Any] = {"httpMethod": http_method, "path": path}
+    if body is not _MISSING:
+        payload["body"] = body
+    return await host_request("paperclip.request", payload)
+
+
+async def finish(status: str, summary: str) -> dict[str, Any]:
+    """Record a terminal intent; the host applies it after complete settlement."""
+    if status not in {"blocked", "in_review", "done"}:
+        raise ValueError("paperclip.finish requires blocked, in_review, or done")
+    if not isinstance(summary, str) or not summary.strip():
+        raise ValueError("paperclip.finish requires a nonempty summary")
+    return await host_request("paperclip.finish", {"status": status, "summary": summary})
