+import { isAbsolute, posix } from "node:path";
+import type { ManagedKernelSandbox } from "./shared.js";
+
+const RUNTIME = "/opt/paperclip/runtime";
+const INSTRUCTIONS = "/opt/paperclip/managed-instructions.md";
+export const MANAGED_KERNEL_PYTHON = `${RUNTIME}/kernel-env/bin/python`;
+const HOST_SESSION_DIR = "/run/prime/session";
+const HOST_ARTIFACTS_ROOT = "/run/prime/session-artifacts";
+
+export interface ManagedKernelLaunch {
+	command: string;
+	args: string[];
+}
+
+/** The model-controlled kernel must not inherit the native worker's IPC or proc view. */
+export function managedKernelLaunch(
+	python: string,
+	{ workspace, readPaths, kernelStateDir, harnessStateDir, depth, maxDepth }: ManagedKernelSandbox,
+): ManagedKernelLaunch {
+	if (process.platform !== "linux") throw new Error("Managed kernel isolation requires Linux bubblewrap");
+	const artifactDir = posix.dirname(kernelStateDir);
+	if (
+		!artifactDir.startsWith(`${HOST_ARTIFACTS_ROOT}/`) ||
+		posix.basename(kernelStateDir) !== "kernel-state" ||
+		harnessStateDir !== `${artifactDir}/harness` ||
+		[kernelStateDir, harnessStateDir].some(
+			(path) => !isAbsolute(path) || posix.normalize(path) !== path || path.includes("\0"),
+		) ||
+		!Number.isSafeInteger(depth) ||
+		depth < 0 ||
+		!Number.isSafeInteger(maxDepth) ||
+		depth > maxDepth ||
+		maxDepth !== 2
+	) {
+		throw new Error("Managed kernel artifacts or recursion scope is invalid");
+	}
+	if (python !== MANAGED_KERNEL_PYTHON) throw new Error("Managed kernel requires the pinned runtime interpreter");
+	if (
+		!isAbsolute(workspace) ||
+		workspace === "/" ||
+		workspace.includes("\0") ||
+		posix.normalize(workspace) !== workspace ||
+		["/usr", "/etc", "/sys", "/proc", "/dev", "/run", "/opt/paperclip", "/home/prime"].some(
+			(path) => workspace === path || workspace.startsWith(`${path}/`) || path.startsWith(`${workspace}/`),
+		)
+	) {
+		throw new Error("Managed kernel workspace overlaps a protected mount");
+	}
+	const paths = new Set(readPaths);
+	if (!paths.has(workspace) || !paths.has(RUNTIME) || !paths.has(INSTRUCTIONS)) {
+		throw new Error("Managed kernel is missing its approved read mounts");
+	}
+	const workspacePrefix = `${workspace}/`;
+	for (const path of paths) {
+		if (
+			path !== workspace &&
+			path !== RUNTIME &&
+			path !== INSTRUCTIONS &&
+			path !== HOST_SESSION_DIR &&
+			path !== HOST_ARTIFACTS_ROOT &&
+			!(path.startsWith(workspacePrefix) && posix.normalize(path) === path && !path.includes("\0")) &&
+			!/^\/opt\/paperclip\/skills\/\d+$/.test(path)
+		) {
+			throw new Error("Managed kernel read mount is not assigned");
+		}
+	}
+	const artifactParents: string[] = [];
+	for (let parent = posix.dirname(artifactDir); parent !== "/"; parent = posix.dirname(parent)) {
+		artifactParents.unshift(parent);
+	}
+	const args = [
+		"--die-with-parent",
+		"--new-session",
+		"--unshare-all",
+		"--cap-drop",
+		"ALL",
+		"--clearenv",
+		"--ro-bind",
+		"/usr",
+		"/usr",
+		"--symlink",
+		"usr/bin",
+		"/bin",
+		"--symlink",
+		"usr/lib",
+		"/lib",
+		"--symlink",
+		"usr/lib64",
+		"/lib64",
+		"--proc",
+		"/proc",
+		"--dev",
+		"/dev",
+		"--tmpfs",
+		"/tmp",
+		"--dir",
+		"/home/prime",
+		"--dir",
+		"/opt/paperclip/skills",
+		"--setenv",
+		"HOME",
+		"/home/prime",
+		"--setenv",
+		"PATH",
+		"/usr/bin:/bin",
+		"--setenv",
+		"TMPDIR",
+		"/tmp",
+		"--setenv",
+		"PYTHONDONTWRITEBYTECODE",
+		"1",
+		"--setenv",
+		"PYTHONUNBUFFERED",
+		"1",
+		"--setenv",
+		"PRIME_AGENT_INSTALL_UV",
+		"0",
+		"--setenv",
+		"PRIME_AGENT_KERNEL_PYTHON",
+		MANAGED_KERNEL_PYTHON,
+		"--setenv",
+		"RLM_DEPTH",
+		String(depth),
+		"--setenv",
+		"RLM_MAX_DEPTH",
+		String(maxDepth),
+		"--setenv",
+		"RLM_HARNESS_STATE_DIR",
+		harnessStateDir,
+		"--bind",
+		workspace,
+		workspace,
+	];
+	for (const parent of artifactParents) args.push("--dir", parent);
+	args.push(
+		"--dir",
+		artifactDir,
+		"--bind",
+		kernelStateDir,
+		kernelStateDir,
+		"--bind",
+		harnessStateDir,
+		harnessStateDir,
+	);
+	for (const path of paths) {
+		if (path !== workspace && path !== HOST_SESSION_DIR && path !== HOST_ARTIFACTS_ROOT)
+			args.push("--ro-bind", path, path);
+	}
+	args.push("--chdir", workspace, python, "-m", "rlm.repl");
+	return { command: "/usr/bin/bwrap", args };
+}
