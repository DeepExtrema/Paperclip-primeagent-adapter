+import { once } from "node:events";
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { type createConnection, createServer, type Socket } from "node:net";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createDeferred } from "../src/core/kernel/shared.js";
+import {
+	canonicalManagedSchemaDigest,
+	loadManagedPrimeRuntime,
+	type ManagedPrimeFrame,
+	type ManagedPrimeManifest,
+	ManagedPrimeRuntime,
+	managedCodexTransport,
+} from "../src/core/managed-prime-runtime.js";
+import {
+	createManagedMcpTools,
+	managedPaperclipFinish,
+	managedPaperclipRequest,
+} from "../src/core/managed-prime-tools.js";
+
+const socketRoute = vi.hoisted(() => ({ path: "" }));
+vi.mock("node:net", async (importOriginal) => {
+	const net = await importOriginal<Record<string, unknown> & { createConnection: typeof createConnection }>();
+	return {
+		...net,
+		createConnection: (options: { path: string; allowHalfOpen: boolean }) =>
+			net.createConnection({ ...options, path: socketRoute.path }),
+	};
+});
+
+const tempDirs: string[] = [];
+afterEach(() => {
+	for (const dir of tempDirs.splice(0)) rmSync(dir, { recursive: true, force: true });
+	socketRoute.path = "";
+});
+
+function fixtureManifest(workspace: string): ManagedPrimeManifest {
+	return {
+		version: 2,
+		authorityDigest: "a".repeat(64),
+		operationId: "operation-1",
+		turnId: "turn-1",
+		model: "openai-codex/gpt-6.1-sol",
+		session: { id: "session-1", directory: "/run/prime/session", resume: false },
+		harness: { maxSubagentDepth: 2, maxSubagents: 4 },
+		instruction: "Complete the assigned task",
+		prompt: "Complete the assigned task",
+		workspace,
+		deadlineAt: "2999-01-01T00:00:00.000Z",
+		mcp: [
+			{
+				connectionId: "approved",
+				tools: [
+					{
+						name: "approved.call",
+						description: "Approved action",
+						inputSchema: { type: "object" },
+						schemaSha256: "b".repeat(64),
+						policy: "approval",
+					},
+				],
+			},
+		],
+		localTools: [
+			{
+				name: "ipython",
+				policy: "workspace-write",
+				inputSchema: { type: "object", properties: { code: { type: "string" } }, required: ["code"] },
+				schemaSha256: "c".repeat(64),
+			},
+		],
+		readPaths: [
+			workspace,
+			"/run/prime/session",
+			"/run/prime/session-artifacts",
+			"/opt/paperclip/managed-instructions.md",
+			"/opt/paperclip/runtime",
+			"/opt/paperclip/skills/0",
+		],
+	};
+}
+
+interface RequestEnvelope {
+	version: number;
+	authorityDigest: string;
+	operationId: string;
+	requestId: string;
+	payload: { method: string; targetRequestId?: string; turnId?: string; connectionId?: string; request?: unknown };
+}
+
+async function withBroker<T>(
+	handler: (request: RequestEnvelope, socket: Socket) => void,
+	run: (manifest: ManagedPrimeManifest) => Promise<T>,
+): Promise<T> {
+	const dir = mkdtempSync(join(tmpdir(), "prime-managed-ipc-"));
+	tempDirs.push(dir);
+	const path = join(dir, "ipc.sock");
+	socketRoute.path = path;
+	const server = createServer({ allowHalfOpen: true }, (socket) => {
+		let input = "";
+		socket.on("data", (bytes: Buffer) => {
+			input += bytes.toString("utf8");
+			const end = input.indexOf("\n");
+			if (end < 0) return;
+			socket.removeAllListeners("data");
+			handler(JSON.parse(input.slice(0, end)) as RequestEnvelope, socket);
+		});
+	});
+	server.listen(path);
+	await once(server, "listening");
+	try {
+		return await run(fixtureManifest(dir));
+	} finally {
+		server.close();
+		await once(server, "close");
+	}
+}
+
+function frame(requestId: string, sequence: number, kind: "result" | "provider_event", data: object): string {
+	return `${JSON.stringify({ version: 2, requestId, sequence, kind, [kind === "result" ? "result" : "event"]: data })}\n`;
+}
+
+describe("managed Prime manifest and restricted IPC", () => {
+	it("loads only the assigned credential-free manifest, refusing extra forwarding fields and arbitrary paths", async () => {
+		const dir = mkdtempSync(join(tmpdir(), "prime-managed-manifest-"));
+		tempDirs.push(dir);
+		const manifest = fixtureManifest(dir);
+		const path = join(dir, "manifest.json");
+		writeFileSync(path, JSON.stringify(manifest));
+		const loaded = await loadManagedPrimeRuntime(path);
+		expect(loaded.manifest.workspace).toBe(dir);
+		for (const invalid of [
+			{ ...manifest, version: 1 },
+			{ ...manifest, model: "openai-codex/" },
+			{ ...manifest, model: "openai-codex/https://provider.example" },
+			{ ...manifest, session: { ...manifest.session, directory: dir } },
+			{ ...manifest, session: { ...manifest.session, id: "../other" } },
+			{ ...manifest, session: { ...manifest.session, resume: "yes" } },
+			{ ...manifest, session: { ...manifest.session, bearer: "secret" } },
+			{ ...manifest, harness: { ...manifest.harness, maxSubagents: 5 } },
+			{ ...manifest, gatewayUrl: "https://gateway.example" },
+			{ ...manifest, localTools: [{ ...manifest.localTools[0], name: "bash" }] },
+			{ ...manifest, readPaths: [...manifest.readPaths, "/root/.config"] },
+			{ ...manifest, mcp: [{ ...manifest.mcp[0], tools: [{ ...manifest.mcp[0].tools[0], bearer: "secret" }] }] },
+		]) {
+			writeFileSync(path, JSON.stringify(invalid));
+			await expect(loadManagedPrimeRuntime(path)).rejects.toThrow();
+		}
+	});
+
+	it("loads an authorized manifest with a large assigned instruction", async () => {
+		const dir = mkdtempSync(join(tmpdir(), "prime-managed-large-manifest-"));
+		tempDirs.push(dir);
+		const instruction = "assigned ".repeat(140_000);
+		const path = join(dir, "manifest.json");
+		writeFileSync(path, JSON.stringify({ ...fixtureManifest(dir), instruction }));
+		const runtime = await loadManagedPrimeRuntime(path);
+		expect(runtime.manifest.instruction).toBe(instruction);
+	});
+
+	it("canonicalizes approved schema hashes independently of object insertion order", () => {
+		const first = {
+			required: ["code"],
+			properties: { code: { type: "string", description: "Run code" } },
+			type: "object",
+		};
+		const reordered = {
+			type: "object",
+			properties: { code: { description: "Run code", type: "string" } },
+			required: ["code"],
+		};
+		expect(canonicalManagedSchemaDigest(first)).toBe(canonicalManagedSchemaDigest(reordered));
+		expect(canonicalManagedSchemaDigest({ ...first, required: ["different"] })).not.toBe(
+			canonicalManagedSchemaDigest(first),
+		);
+	});
+
+	it("correlates split catalog frames without accepting a foreign request ID", async () => {
+		await withBroker(
+			(request, socket) => {
+				expect(request).toMatchObject({
+					version: 2,
+					authorityDigest: "a".repeat(64),
+					operationId: "operation-1",
+					payload: { method: "provider.catalog" },
+				});
+				const line = frame(request.requestId, 0, "result", {
+					kind: "catalog",
+					provider: "openai-codex",
+					model: "gpt-6.1-sol",
+					available: true,
+				});
+				socket.write(line.slice(0, 11));
+				socket.end(line.slice(11));
+			},
+			async (manifest) => {
+				const runtime = new ManagedPrimeRuntime(manifest);
+				const result = [];
+				for await (const item of runtime.request({ method: "provider.catalog" })) result.push(item);
+				expect(result).toMatchObject([
+					{ kind: "result", sequence: 0, result: { kind: "catalog", available: true } },
+				]);
+				expect(runtime.hasPendingRequests()).toBe(false);
+			},
+		);
+		await withBroker(
+			(_request, socket) => {
+				socket.end(frame("foreign-request", 0, "result", { kind: "catalog", available: true }));
+			},
+			async (manifest) => {
+				const runtime = new ManagedPrimeRuntime(manifest);
+				await expect(
+					(async () => {
+						for await (const _ of runtime.request({ method: "provider.catalog" })) {
+							/* consume */
+						}
+					})(),
+				).rejects.toThrow();
+			},
+		);
+	});
+
+	it("allows control after execute expiry but refuses new dispatch and wrong result kinds", async () => {
+		await withBroker(
+			(request, socket) => {
+				expect(request.payload.method).toBe("operation.status");
+				socket.end(frame(request.requestId, 0, "result", { kind: "operation", fence: "stopped" }));
+			},
+			async (manifest) => {
+				const runtime = new ManagedPrimeRuntime({ ...manifest, deadlineAt: "2000-01-01T00:00:00.000Z" });
+				await expect(
+					(async () => {
+						for await (const _ of runtime.request({ method: "provider.catalog" })) {
+							/* expired */
+						}
+					})(),
+				).rejects.toThrow("deadline expired");
+				const frames = [];
+				for await (const item of runtime.request({ method: "operation.status" })) frames.push(item);
+				expect(frames).toMatchObject([{ kind: "result", result: { kind: "operation", fence: "stopped" } }]);
+			},
+		);
+		await withBroker(
+			(request, socket) => {
+				socket.end(frame(request.requestId, 0, "result", { kind: "operation" }));
+			},
+			async (manifest) => {
+				const runtime = new ManagedPrimeRuntime(manifest);
+				await expect(
+					(async () => {
+						for await (const _ of runtime.request({ method: "provider.catalog" })) {
+							/* wrong result */
+						}
+					})(),
+				).rejects.toThrow("does not match request method");
+			},
+		);
+	});
+
+	it("holds writer ownership after truncated provider stream until correlated terminal replay", async () => {
+		let originalRequestId = "";
+		await withBroker(
+			(request, socket) => {
+				if (request.payload.method === "provider.stream") {
+					originalRequestId = request.requestId;
+					expect(request.payload.turnId).toBe("turn-1");
+					socket.end(
+						frame(request.requestId, 0, "provider_event", {
+							type: "response.created",
+							response: { id: "response-1" },
+						}) +
+							frame(request.requestId, 1, "provider_event", {
+								type: "response.completed",
+								response: { id: "response-1", status: "completed" },
+							}),
+					);
+					return;
+				}
+				expect(request.payload).toMatchObject({ method: "provider.status", targetRequestId: originalRequestId });
+				socket.end(
+					frame(request.requestId, 1, "provider_event", {
+						type: "response.completed",
+						response: { id: "response-1", status: "completed" },
+					}) +
+						frame(request.requestId, 2, "result", {
+							kind: "provider",
+							providerRequestId: "response-1",
+							state: "completed",
+						}),
+				);
+			},
+			async (manifest) => {
+				const runtime = new ManagedPrimeRuntime(manifest);
+				const events: ManagedPrimeFrame[] = [];
+				await expect(
+					(async () => {
+						for await (const item of runtime.requestProviderStream({ model: "gpt-6.1-sol" })) events.push(item);
+					})(),
+				).rejects.toThrow("without a complete result");
+				expect(events).toMatchObject([
+					{ kind: "provider_event", event: { type: "response.created" } },
+					{ kind: "provider_event", event: { type: "response.completed" } },
+				]);
+				expect(runtime.hasPendingRequests()).toBe(true);
+				const pending = runtime.waitForPendingRequests();
+				for await (const _ of runtime.request({ method: "provider.status", targetRequestId: originalRequestId })) {
