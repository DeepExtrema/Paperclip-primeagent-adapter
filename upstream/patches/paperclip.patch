+    await expect(reservePrimePhysicalWriter(
+      admissionDb({ currentAdapter: "prime_bff", active: [{ root, prime: false }] }),
+      "new-run", child,
+    )).rejects.toBeInstanceOf(PrimeWorkspaceAdmissionError);
+    await expect(reservePrimePhysicalWriter(
+      admissionDb({ currentAdapter: "codex", active: [{ root, prime: true }] }),
+      "new-run", child,
+    )).rejects.toThrow("Workspace is reserved by an active physical writer");
+    await expect(reservePrimePhysicalWriter(
+      admissionDb({ currentAdapter: "codex", active: [{ root, prime: false }] }),
+      "new-run", child,
+    )).resolves.toBeUndefined();
