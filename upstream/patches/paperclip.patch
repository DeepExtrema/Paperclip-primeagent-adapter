@@ -0,0 +1,933 @@
+import { createHash } from "node:crypto";
+import { arch, platform, release } from "node:os";
+import { and, desc, eq, inArray } from "drizzle-orm";
+import { agents, heartbeatRuns, issues, primeRuntimeAuthorities, primeBrokerRequests, primeBrokerReceipts, toolInvocations, toolActionRequests, toolMcpGateways, type Db } from "@paperclipai/db";
+import { PRIME_RUNTIME_WIRE_LIMIT_BYTES, primeBrokerRequestSchema, primeRuntimeAuthoritySchema, type PrimeBrokerRequest, type PrimeBrokerFrame, type PrimeBrokerResult, type PrimeRuntimeAuthority } from "@paperclipai/shared";
+import type { ManagedAiCredentialLifecycle } from "@paperclipai/adapter-utils";
+import { assertPrimeExecuteCurrent, primeDigest, selectPrimeSubscription, verifyPrimeCapability } from "./prime-runtime-authority.js";
+import { createToolGatewayService, storedInvocationResult } from "./tool-gateway.js";
+import { logger } from "../middleware/logger.js";
+
+const CATALOG_URL = "https://chatgpt.com/backend-api/codex/models?client_version=0.162.0";
+const RESPONSES_URL = "https://chatgpt.com/backend-api/codex/responses";
+const CODEX_USER_AGENT = `pi (${platform()} ${release()}; ${arch()})`;
+const ownedDispatches = new Set<string>();
+const ownedConnections = new Map<string, AbortController>();
+const ownedPaperclipEffects = new Set<string>();
+interface PrimeHostRun {
+  credential: ManagedAiCredentialLifecycle;
+  agentToken: string;
+  apiBaseUrl: string;
+}
+interface PrimeHostRunOwner extends PrimeHostRun {
+  closing: boolean;
+  providerUses: Map<AbortController, Promise<void>>;
+}
+const primeHostRuns = new Map<string, PrimeHostRunOwner>();
+function activePrimeHostRun(runId: string) {
+  const owner = primeHostRuns.get(runId);
+  return owner?.closing ? undefined : owner;
+}
+
+/** Close credential admission, then drain host use; this does not settle remote work. */
+export function registerPrimeHostRun(runId: string, input: PrimeHostRun) {
+  if (primeHostRuns.has(runId)) throw new Error("Prime broker host run already registered");
+  const owner: PrimeHostRunOwner = { ...input, closing: false, providerUses: new Map() };
+  primeHostRuns.set(runId, owner);
+  return async () => {
+    owner.closing = true;
+    for (const controller of owner.providerUses.keys()) controller.abort();
+    // An admitted OAuth rotation owns its separate signal. Wait for its commit
+    // or durable uncertain fence rather than cancelling credential settlement.
+    await Promise.all(owner.providerUses.values());
+    if (primeHostRuns.get(runId) === owner) primeHostRuns.delete(runId);
+  };
+}
+
+/** Only the host-injected adapter closure calls this after a BFF-settled terminal receipt. */
+export async function finalizePrimeRun(db: Db, input: {
+  runId: string; intentId: string; issueId: string; status: "blocked" | "in_review" | "done";
+  summary: string; operationId: string; terminalReceiptId: string;
+}, fetchImpl: typeof fetch = fetch) {
+  if (!input.terminalReceiptId || input.terminalReceiptId.length > 256 || input.operationId !== input.runId)
+    throw new Error("Prime settled terminal receipt is required");
+  const registered = activePrimeHostRun(input.runId);
+  if (!registered) throw new Error("Prime host run has no owned actor session");
+  await db.transaction(async (tx) => {
+    const [row] = await tx.select().from(primeRuntimeAuthorities).where(eq(primeRuntimeAuthorities.runId, input.runId)).for("update");
+    if (!row || row.fenced !== "open" || row.providerSettlement !== "settled" ||
+        row.governedSettlement !== "settled" || row.finalizationReceiptId || row.finalizationAppliedAt)
+      throw new Error("Prime finalization cannot be admitted");
+    const authority = primeRuntimeAuthoritySchema.parse(row.authority);
+    const intent = { intentId: input.intentId, issueId: input.issueId, status: input.status, summary: input.summary };
+    if (input.issueId !== authority.identity.issueId || input.operationId !== authority.operationId ||
+        !row.finalizationIntent || primeDigest(row.finalizationIntent) !== primeDigest(intent))
+      throw new Error("Prime finalization intent does not match immutable authority");
+    const [run] = await tx.select().from(heartbeatRuns).where(eq(heartbeatRuns.id, input.runId));
+    const [issue] = await tx.select().from(issues).where(eq(issues.id, input.issueId));
+    if (!run || run.status !== "running" || run.controllerBootId !== authority.identity.controllerId ||
+        !issue || issue.companyId !== authority.identity.companyId ||
+        issue.status !== "in_progress" || issue.assigneeAgentId !== authority.identity.agentId)
+      throw new Error("Prime finalization actor or task changed");
+    const unsettled = await tx.select({ method: primeBrokerRequests.method, state: primeBrokerRequests.state })
+      .from(primeBrokerRequests).where(eq(primeBrokerRequests.runId, input.runId));
+    if (unsettled.some((item) => effectMethods[item.method] && !terminalStates[item.state]))
+      throw new Error("Prime finalization has outstanding effects");
+    const [finish] = await tx.select().from(primeBrokerRequests)
+      .where(and(eq(primeBrokerRequests.runId, input.runId), eq(primeBrokerRequests.requestId, input.intentId)));
+    if (!finish || finish.method !== "paperclip.finish" || finish.state !== "completed")
+      throw new Error("Prime finalization intent was not recorded");
+    await tx.update(primeRuntimeAuthorities).set({ finalizationReceiptId: input.terminalReceiptId, updatedAt: new Date() })
+      .where(eq(primeRuntimeAuthorities.runId, input.runId));
+  });
+  try {
+    const response = await fetchImpl(`${registered.apiBaseUrl}/api/issues/${input.issueId}`, {
+      method: "PATCH", redirect: "manual",
+      headers: { Authorization: `Bearer ${registered.agentToken}`, "content-type": "application/json" },
+      body: JSON.stringify({ status: input.status, comment: input.summary }),
+    });
+    if (!response.ok) throw new Error("Prime issue disposition was not accepted by the existing actor/artifact gates");
+    await db.update(primeRuntimeAuthorities).set({ finalizationAppliedAt: new Date(), updatedAt: new Date() })
+      .where(and(eq(primeRuntimeAuthorities.runId, input.runId), eq(primeRuntimeAuthorities.finalizationReceiptId, input.terminalReceiptId)));
+  } catch {
+    // The HTTP boundary could have committed before its receipt was lost. Do not redispatch.
+    await db.update(primeRuntimeAuthorities).set({ fenced: "uncertain", governedSettlement: "uncertain", updatedAt: new Date() })
+      .where(eq(primeRuntimeAuthorities.runId, input.runId));
+    throw new Error("Prime issue finalization uncertain; writer exclusion retained");
+  }
+}
+const effectMethods: Record<string, true> = { "provider.stream": true, "mcp.tools.call": true, "paperclip.request": true, "paperclip.finish": true };
+const executeMethods: Record<string, true> = { "provider.catalog": true, "provider.stream": true, "mcp.tools.list": true, "mcp.tools.call": true, "paperclip.request": true, "paperclip.finish": true };
+const controlMethods: Record<string, true> = { "provider.abort": true, "operation.stop": true };
+const terminalStates: Record<string, true> = { completed: true, failed: true, aborted: true };
+const dispatchKey = (runId: string, requestId: string) => `${runId}:${requestId}`;
+
+/** Known live dispatches may overlap for native children; unresolved ownership never may. */
+export function primeEffectBlocksExecution(method: string, state: string, owned: boolean): boolean {
+  return Boolean(effectMethods[method] && !terminalStates[state] &&
+    !(owned && (state === "dispatching" || state === "streaming")));
+}
+
+type AuthorityRow = typeof primeRuntimeAuthorities.$inferSelect;
+
+async function projection(db: Db, row: AuthorityRow): Promise<Extract<PrimeBrokerResult, { kind: "operation" }>> {
+  const effects = await db.select({ state: primeBrokerRequests.state, method: primeBrokerRequests.method }).from(primeBrokerRequests).where(eq(primeBrokerRequests.runId, row.runId));
+  const unresolved = effects.filter((effect) => effectMethods[effect.method] && !terminalStates[effect.state]);
+  return { kind: "operation", fenced: row.fenced !== "open", provider: unresolved.some((effect) => effect.method === "provider.stream") || row.providerSettlement === "uncertain" ? "uncertain" : "settled", governedActions: unresolved.some((effect) => effect.method !== "provider.stream") || row.governedSettlement === "uncertain" ? "uncertain" : "settled", outstandingEffects: unresolved.length };
+}
+
+
+async function receipts(db: Db, runId: string, requestId: string) {
+  const rows = await db.select().from(primeBrokerReceipts).where(and(eq(primeBrokerReceipts.runId, runId), eq(primeBrokerReceipts.requestId, requestId))).orderBy(primeBrokerReceipts.sequence);
+  return rows.map((item) => item.frame as PrimeBrokerFrame);
+}
+
+function assertPrimeFrameSize(frame: PrimeBrokerFrame) {
+  if (Buffer.byteLength(JSON.stringify(frame), "utf8") + 1 > PRIME_RUNTIME_WIRE_LIMIT_BYTES)
+    throw new Error("Prime broker receipt exceeds the managed wire limit");
+}
+
+async function append(db: Db, runId: string, requestId: string, frame: { kind: "provider_event"; event: Record<string, unknown> } | { kind: "result"; result: PrimeBrokerResult } | { kind: "error"; error: { code: string; message: string } }) {
+  return db.transaction(async (tx) => {
+    const [request] = await tx.select().from(primeBrokerRequests).where(and(eq(primeBrokerRequests.runId, runId), eq(primeBrokerRequests.requestId, requestId))).for("update");
+    if (!request) throw new Error("Unknown Prime request");
+    if (terminalStates[request.state]) throw new Error("Cannot append to settled Prime request");
+    const stamped = { ...frame, version: 2 as const, requestId, sequence: request.nextSequence } as PrimeBrokerFrame;
+    assertPrimeFrameSize(stamped);
+    await tx.insert(primeBrokerReceipts).values({ runId, requestId, sequence: request.nextSequence, frame: stamped });
+    await tx.update(primeBrokerRequests).set({ nextSequence: request.nextSequence + 1, updatedAt: new Date() }).where(and(eq(primeBrokerRequests.runId, runId), eq(primeBrokerRequests.requestId, requestId)));
+    return stamped;
+  });
+}
+
+async function settle(db: Db, runId: string, requestId: string, state: string, result: PrimeBrokerResult) {
+  return db.transaction(async (tx) => {
+    // Every stop, approval claim, reservation and settlement takes authority first.
+    const [authority] = await tx.select().from(primeRuntimeAuthorities).where(eq(primeRuntimeAuthorities.runId, runId)).for("update");
+    if (!authority) throw new Error("Prime authority no longer exists");
+    const [request] = await tx.select().from(primeBrokerRequests).where(and(eq(primeBrokerRequests.runId, runId), eq(primeBrokerRequests.requestId, requestId))).for("update");
+    if (!request) throw new Error("Unknown Prime request");
+    if (terminalStates[request.state]) {
+      const [receipt] = await tx.select().from(primeBrokerReceipts).where(and(eq(primeBrokerReceipts.runId, runId), eq(primeBrokerReceipts.requestId, requestId))).orderBy(desc(primeBrokerReceipts.sequence));
+      if (!receipt) throw new Error("Terminal Prime request has no durable receipt");
+      return receipt.frame as PrimeBrokerFrame;
+    }
+    if (state === "completed" && request.method === "paperclip.finish" && result.kind === "finalization") {
+      const intent = { intentId: result.intentId, issueId: result.issueId, status: result.status, summary: result.summary };
+      if (intent.intentId !== requestId || authority.finalizationIntent && primeDigest(authority.finalizationIntent) !== primeDigest(intent))
+        throw new Error("Prime finalization intent changed");
+      if (authority.fenced !== "open") throw new Error("Prime finalization was fenced");
+      const outstanding = await tx.select({ requestId: primeBrokerRequests.requestId, method: primeBrokerRequests.method, state: primeBrokerRequests.state })
+        .from(primeBrokerRequests).where(eq(primeBrokerRequests.runId, runId));
+      if (outstanding.some((row) => row.requestId !== requestId && effectMethods[row.method] && !terminalStates[row.state]))
+        throw new Error("Prime finalization requires settled effects");
+      await tx.update(primeRuntimeAuthorities).set({ finalizationIntent: intent, updatedAt: new Date() })
+        .where(eq(primeRuntimeAuthorities.runId, runId));
+    }
+    const frame: PrimeBrokerFrame = { kind: "result", version: 2, requestId, sequence: request.nextSequence, result };
+    assertPrimeFrameSize(frame);
+    await tx.insert(primeBrokerReceipts).values({ runId, requestId, sequence: request.nextSequence, frame });
+    await tx.update(primeBrokerRequests).set({ state, nextSequence: request.nextSequence + 1, updatedAt: new Date() }).where(and(eq(primeBrokerRequests.runId, runId), eq(primeBrokerRequests.requestId, requestId)));
+    if (state === "uncertain" && effectMethods[request.method]) {
+      await tx.update(primeRuntimeAuthorities).set({ fenced: authority.fenced === "open" ? "uncertain" : authority.fenced, updatedAt: new Date(),
+        ...(request.method === "provider.stream" ? { providerSettlement: "uncertain" } : { governedSettlement: "uncertain" }) }).where(eq(primeRuntimeAuthorities.runId, runId));
+    } else if (terminalStates[state] && effectMethods[request.method]) {
+      const effects = await tx.select({ state: primeBrokerRequests.state }).from(primeBrokerRequests).where(and(eq(primeBrokerRequests.runId, runId), eq(primeBrokerRequests.method, request.method)));
+      if (effects.every((effect) => terminalStates[effect.state])) await tx.update(primeRuntimeAuthorities).set({
+        ...(request.method === "provider.stream" ? { providerSettlement: "settled" } : { governedSettlement: "settled" }),
+        updatedAt: new Date(),
+      }).where(eq(primeRuntimeAuthorities.runId, runId));
+    }
+    return frame;
+  });
