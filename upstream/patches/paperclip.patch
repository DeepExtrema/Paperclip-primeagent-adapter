+            and g.kind = 'user'
+            and a.runtime_config -> 'aiConnection' ->> 'connectionId' = c.id::text
+            and a.runtime_config -> 'aiConnection' ->> 'grantId' = g.id::text
+            and a.runtime_config -> 'aiConnection' ->> 'method' = 'subscription')
