+/** Reject asynchronous selector results unless both sides of that work share one complete DB generation. */
+async function mutableSnapshot(db: Db, authority: PrimeRuntimeAuthority) {
+  const before = await coherentMutableDecision(db, authority);
+  const { identity, selection, mcp } = authority;
+  const [agent] = await db.select().from(agents).where(and(eq(agents.id, identity.agentId), eq(agents.companyId, identity.companyId)));
+  if (!agent || agent.adapterType !== "prime_bff") throw new Error("Prime adapter is not selected");
+  const selected = await selectPrimeSubscription(db, {
+    companyId: identity.companyId, agentId: identity.agentId,
+    responsibleUserId: identity.responsibleUserId, binding: agent.runtimeConfig?.aiConnection, model: selection.model,
+  });
+  if (selected.grant.id !== selection.grantId || selected.connection.id !== selection.connectionId)
+    throw new Error("Prime subscription selection changed");
+  const [gateway] = mcp.gatewayId ? await db.select().from(toolMcpGateways).where(eq(toolMcpGateways.id, mcp.gatewayId)) : [];
+  const after = await coherentMutableDecision(db, authority, selected.connection.config, agent.runtimeConfig?.aiConnection);
+  if (Boolean(gateway) !== Boolean(mcp.gatewayId) || gateway && (gateway.metadata?.primeRuntimeAssignmentDigest !== mcp.assignmentDigest || gateway.metadata?.agentId !== identity.agentId || gateway.status !== "active" || gateway.archivedAt))
+    throw new Error("Prime MCP assignment changed");
+  for (const key of ["controller", "issue", "run", "grant", "workspace", "instructions", "skills", "tools"] as const) {
+    if (after[key] !== before[key]) throw new Error(`Prime ${key} authority changed during preparation`);
+  }
+  return { agent, generations: {
+    controller: after.controller, issue: after.issue, run: after.run, grant: after.grant,
+    workspace: after.workspace, instructions: after.instructions, skills: after.skills, tools: after.tools,
+  } };
+}
+
+async function liveSnapshot(db: Db, authority: PrimeRuntimeAuthority) {
+  const first = await mutableSnapshot(db, authority);
+  if (await realpath(authority.workspace.root) !== authority.workspace.realRoot) throw new Error("Prime workspace root changed");
+  await assertSafePrimeWorkspace(authority.workspace.root);
+  const exported = await agentInstructionsService().exportFiles(first.agent, { rejectSymlinks: true });
+  const instructions = primeDigest([first.generations.instructions, exported.entryFile, exported.files]);
+  await Promise.all(authority.skills.map(async (skill) => {
+    if (await realpath(skill.path) !== skill.path || await skillDirectoryDigest(skill.path) !== skill.sha256)
+      throw new Error("Prime skill contents changed");
+  }));
+  if (await realpath(authority.workspace.root) !== authority.workspace.realRoot) throw new Error("Prime workspace root changed");
+  // Metadata/asset reads above may have yielded through revocation or reassignment.
+  const last = await mutableSnapshot(db, authority);
+  for (const key of Object.keys(last.generations) as Array<keyof typeof last.generations>) {
+    if (last.generations[key] !== first.generations[key])
+      throw new Error(`Prime ${key} authority changed during preparation`);
+  }
+  return { ...last.generations, instructions };
+}
+
+/** Recheck before every new provider/tool dispatch; observation and stop do not use mutable assignment. */
+export async function assertPrimeExecuteCurrent(db: Db, authority: PrimeRuntimeAuthority) {
+  const deadline = Date.parse(authority.executeDeadlineAt);
+  if (!(Date.now() < deadline)) throw new Error("Prime execute authority expired");
+  const live = await liveSnapshot(db, authority);
+  for (const key of Object.keys(live) as Array<keyof typeof live>) {
+    if (live[key] !== authority.generations[key]) throw new Error(`Prime ${key} authority was revoked or changed`);
+  }
+  // Preparing the live snapshot performs I/O; it must not carry admission across expiry.
+  if (!(Date.now() < deadline)) throw new Error("Prime execute authority expired");
+}
