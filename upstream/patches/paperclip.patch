+const credentialSettlementPending = { kind: "managed_ai_credential_settlement", phase: "pending" };
+const credentialSettlementSettled = { kind: "managed_ai_credential_settlement", phase: "settled" };
+
+export function nativeCredentialSettlementIsPending(
+  coordinator: Pick<typeof nativeRunFinalizations.$inferSelect, "recoveryHistory">,
+): boolean {
+  const latest = coordinator.recoveryHistory.findLast(
+    entry => entry.kind === credentialSettlementPending.kind,
+  );
+  return latest?.phase === "pending";
+}
+
+/** Open the durable gate before a managed native provider may persist a result;
+ * only confirmed credential cleanup can close it. */
+export async function recordNativeCredentialSettlement(
+  db: Db, runId: string, phase: "pending" | "settled",
+) {
+  const marker = phase === "pending" ? credentialSettlementPending : credentialSettlementSettled;
+  await db.transaction(async tx => {
+    const current = await tx.select().from(nativeRunFinalizations)
+      .where(eq(nativeRunFinalizations.runId, runId)).for("update")
+      .limit(1).then(rows => rows[0] ?? null);
+    if (!current || current.failureCode === "ai_connection_refresh_uncertain" ||
+        (phase === "pending" && current.phase === "terminal_failure"))
+      throw new Error("native_credential_settlement_admission_missing");
+    const pending = nativeCredentialSettlementIsPending(current);
+    if (phase === "pending" && pending) return;
+    if (phase === "settled" && !pending)
+      throw new Error("native_credential_settlement_confirmation_missing");
+    await tx.update(nativeRunFinalizations).set({
+      recoveryHistory: sql`${nativeRunFinalizations.recoveryHistory} || ${JSON.stringify([marker])}::jsonb`,
+      updatedAt: new Date(),
+    }).where(eq(nativeRunFinalizations.runId, runId));
+  });
+}
