@@ -0,0 +1,48 @@
+import { Router } from "express";
+import type { Db } from "@paperclipai/db";
+import { PRIME_RUNTIME_WIRE_LIMIT_BYTES } from "@paperclipai/shared";
+import { primeBrokerService } from "../services/prime-broker.js";
+
+/** Purpose tokens are checked by the broker; general agent/board JWTs are never accepted. */
+export function primeBrokerRoutes(db: Db, fetchImpl: typeof fetch = fetch) {
+  const router = Router();
+  const broker = primeBrokerService(db, fetchImpl);
+  function headers(req: { headers: Record<string, unknown>; params: Record<string, unknown> }) {
+    const runId = req.params.runId;
+    const binding = req.headers["x-paperclip-run-id"];
+    const auth = req.headers.authorization;
+    if (typeof runId !== "string" || binding !== runId || typeof auth !== "string" || !auth.startsWith("Bearer ") || auth.slice(7).length > 512)
+      throw new Error("Prime run purpose capability is missing or mismatched");
+    return { runId, bearer: auth.slice(7) };
+  }
+  router.get("/heartbeat-runs/:runId/runtime-authority", async (req, res) => {
+    try {
+      const { runId, bearer } = headers(req);
+      res.setHeader("cache-control", "no-store");
+      const body = JSON.stringify(await broker.authority(runId, bearer));
+      if (Buffer.byteLength(body, "utf8") > PRIME_RUNTIME_WIRE_LIMIT_BYTES)
+        throw new Error("Prime authority response exceeds the managed wire limit");
+      res.type("json").send(body);
+    } catch { res.status(403).json({ error: "prime_authority_denied" }); }
+  });
+  router.post("/heartbeat-runs/:runId/prime-broker", async (req, res) => {
+    try {
+      const { runId, bearer } = headers(req);
+      res.setHeader("cache-control", "no-store");
+      res.setHeader("content-type", "application/x-ndjson; charset=utf-8");
+      for await (const frame of broker.request(runId, bearer, req.body)) {
+        if (!res.writableEnded && !res.destroyed) {
+          const encoded = `${JSON.stringify(frame)}\n`;
+          if (Buffer.byteLength(encoded, "utf8") > PRIME_RUNTIME_WIRE_LIMIT_BYTES)
+            throw new Error("Prime broker frame exceeds the managed wire limit");
+          res.write(encoded);
+        }
+      }
+      if (!res.writableEnded && !res.destroyed) res.end();
+    } catch {
+      if (!res.headersSent) res.status(403).json({ error: "prime_broker_denied" });
+      else if (!res.writableEnded && !res.destroyed) res.end();
+    }
+  });
+  return router;
+}
