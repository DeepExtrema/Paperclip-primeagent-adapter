@@ -0,0 +1,44 @@
+import { describe, expect, it } from "vitest";
+import { decodeSubscriptionCredential, primeEffectBlocksExecution } from "./prime-broker.js";
+
+const tokens = { access_token: "fixture-subscription-token", account_id: "fixture-account" };
+
+describe("Prime subscription credentials", () => {
+  it.each([undefined, null, "", " "])("accepts OAuth credentials with an unused API-key field (%s)", (apiKey) => {
+    expect(decodeSubscriptionCredential(JSON.stringify({ OPENAI_API_KEY: apiKey, tokens })))
+      .toEqual({ token: tokens.access_token, accountId: tokens.account_id });
+  });
+
+  it("refuses API-key authentication even when subscription tokens are also present", () => {
+    expect(() => decodeSubscriptionCredential(JSON.stringify({ OPENAI_API_KEY: "fixture-api-key", tokens })))
+      .toThrow(expect.objectContaining({ code: "prime_subscription_unavailable" }));
+  });
+
+  it.each([
+    ["not-json private-fixture-data", "prime_subscription_malformed"],
+    [JSON.stringify({ OPENAI_API_KEY: "fixture-api-key" }), "prime_subscription_missing"],
+    [JSON.stringify({ tokens: { access_token: tokens.access_token } }), "prime_subscription_identity_missing"],
+    [JSON.stringify({ tokens: { access_token: "", account_id: tokens.account_id } }), "prime_subscription_unavailable"],
+    [JSON.stringify({ tokens: { access_token: tokens.access_token, account_id: "" } }), "prime_subscription_unavailable"],
+  ])("classifies an unusable subscription without exposing its content (%s)", (raw, code) => {
+    let failure: unknown;
+    try { decodeSubscriptionCredential(raw); } catch (error) { failure = error; }
+    expect(failure).toMatchObject({ code });
+    expect(String(failure)).not.toMatch(/private-fixture-data|fixture-api-key|fixture-subscription-token|fixture-account/);
+  });
+});
+
+describe("Prime native child dispatch admission", () => {
+  it.each(["dispatching", "streaming"])("distinguishes a live %s provider call from an orphan", (state) => {
+    expect(primeEffectBlocksExecution("provider.stream", state, true)).toBe(false);
+    expect(primeEffectBlocksExecution("provider.stream", state, false)).toBe(true);
+  });
+
+  it.each(["uncertain", "awaiting_approval", "executing"])("retains exclusion for %s work regardless of a stale ownership flag", (state) => {
+    expect(primeEffectBlocksExecution("mcp.tools.call", state, true)).toBe(true);
+  });
+
+  it.each(["completed", "failed", "aborted"])("permits progress after a definite %s effect", (state) => {
+    expect(primeEffectBlocksExecution("provider.stream", state, false)).toBe(false);
+  });
+});
