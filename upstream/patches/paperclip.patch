+async function skillDirectoryDigest(source: string): Promise<string> {
+  const files: Array<[string, string]> = [];
+  async function visit(folder: string) {
+    for (const entry of (await readdir(folder, { withFileTypes: true })).sort((a, b) => a.name.localeCompare(b.name))) {
+      const child = path.join(folder, entry.name);
+      const stat = await lstat(child);
+      if (stat.isSymbolicLink() || !(stat.isDirectory() || stat.isFile())) throw new Error("Prime managed skill contains an unsafe filesystem entry");
+      if (stat.isDirectory()) await visit(child);
+      else files.push([path.relative(source, child), createHash("sha256").update(await readFile(child)).digest("hex")]);
+    }
+  }
+  await visit(source);
+  return primeDigest(files);
