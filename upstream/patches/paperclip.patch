+/** Canonical JSON identity; arrays preserve order and keys use default JS UTF-16 sort. */
+export function primeDigest(value: unknown): string {
+  function canonical(input: unknown): unknown {
+    if (input instanceof Date) return input.toISOString();
+    if (Array.isArray(input)) return input.map(canonical);
+    if (input && typeof input === "object") return Object.fromEntries(Object.keys(input).sort().map((key) => [key, canonical((input as Record<string, unknown>)[key])]));
+    if (typeof input === "number" && !Number.isFinite(input)) throw new Error("Non-finite canonical JSON number");
+    return input;
+  }
+  return createHash("sha256").update(JSON.stringify(canonical(value))).digest("hex");
+}
+export const PRIME_LOCAL_IPYTHON_SCHEMA = {
