diff --git 1/packages/db/src/schema/prime_runtime.ts 2/packages/db/src/schema/prime_runtime.ts
new file mode 100644
index 0000000..1d42aa2
--- /dev/null
+++ 2/packages/db/src/schema/prime_runtime.ts
@@ -0,0 +1,65 @@
+import { pgTable, uuid, text, timestamp, jsonb, integer, bigint, boolean, primaryKey, foreignKey, uniqueIndex, index } from "drizzle-orm/pg-core";
+import { companies } from "./companies.js";
+import { heartbeatRuns } from "./heartbeat_runs.js";
+
+/** Immutable realization; only the fence and settlement projection may advance. */
+export const primeRuntimeAuthorities = pgTable("prime_runtime_authorities", {
+  runId: uuid("run_id").primaryKey().references(() => heartbeatRuns.id),
+  companyId: uuid("company_id").notNull().references(() => companies.id),
+  operationId: text("operation_id").notNull(),
+  authority: jsonb("authority").$type<Record<string, unknown>>().notNull(),
+  digest: text("digest").notNull(),
+  fenced: text("fenced").notNull().default("open"),
+  providerSettlement: text("provider_settlement").notNull().default("settled"),
+  governedSettlement: text("governed_settlement").notNull().default("settled"),
+  workerSettlement: text("worker_settlement").notNull().default("pending"),
+  finalizationIntent: jsonb("finalization_intent").$type<{ intentId: string; issueId: string; status: "blocked" | "in_review" | "done"; summary: string }>(),
+  finalizationReceiptId: text("finalization_receipt_id"),
+  finalizationAppliedAt: timestamp("finalization_applied_at", { withTimezone: true }),
+  createdAt: timestamp("created_at", { withTimezone: true }).notNull().defaultNow(),
+  updatedAt: timestamp("updated_at", { withTimezone: true }).notNull().defaultNow(),
+}, (table) => [uniqueIndex("prime_runtime_authorities_operation_uq").on(table.operationId), index("prime_runtime_authorities_company_idx").on(table.companyId)]);
+
+/** Request identity and argument digest are written before any network/tool effect. */
+export const primeBrokerRequests = pgTable("prime_broker_requests", {
+  runId: uuid("run_id").notNull(),
+  requestId: text("request_id").notNull(),
+  method: text("method").notNull(),
+  argumentsHash: text("arguments_hash").notNull(),
+  effectArgumentsHash: text("effect_arguments_hash"),
+  state: text("state").notNull().default("reserved"),
+  providerRequestId: text("provider_request_id"),
+  invocationId: uuid("invocation_id"),
+  actionRequestId: uuid("action_request_id"),
+  interactionId: uuid("interaction_id"),
+  formalApprovalId: uuid("formal_approval_id"),
+  nextSequence: bigint("next_sequence", { mode: "number" }).notNull().default(0),
+  createdAt: timestamp("created_at", { withTimezone: true }).notNull().defaultNow(),
+  updatedAt: timestamp("updated_at", { withTimezone: true }).notNull().defaultNow(),
+}, (table) => [
+  primaryKey({ name: "prime_broker_requests_pk", columns: [table.runId, table.requestId] }),
+  foreignKey({ name: "prime_broker_requests_run_authority_fk", columns: [table.runId], foreignColumns: [primeRuntimeAuthorities.runId] }),
+  index("prime_broker_requests_run_state_idx").on(table.runId, table.state),
+]);
+
+export const primeBrokerReceipts = pgTable("prime_broker_receipts", {
+  runId: uuid("run_id").notNull(),
+  requestId: text("request_id").notNull(),
+  sequence: integer("sequence").notNull(),
+  frame: jsonb("frame").$type<Record<string, unknown>>().notNull(),
+  createdAt: timestamp("created_at", { withTimezone: true }).notNull().defaultNow(),
+}, (table) => [
+  primaryKey({ name: "prime_broker_receipts_pk", columns: [table.runId, table.requestId, table.sequence] }),
+  foreignKey({ name: "prime_broker_receipts_request_fk", columns: [table.runId, table.requestId], foreignColumns: [primeBrokerRequests.runId, primeBrokerRequests.requestId] }),
+]);
+
+/** Admission record for every local writer; only overlaps involving Prime are exclusive. */
+export const primePhysicalWriters = pgTable("prime_physical_writers", {
+  runId: uuid("run_id").notNull(),
+  root: text("root").notNull(),
+  prime: boolean("prime").notNull(),
+  createdAt: timestamp("created_at", { withTimezone: true }).notNull().defaultNow(),
+}, (table) => [
+  primaryKey({ name: "prime_physical_writers_pk", columns: [table.runId, table.root] }),
+  foreignKey({ name: "prime_physical_writers_run_fk", columns: [table.runId], foreignColumns: [heartbeatRuns.id] }).onDelete("restrict"),
+]);
diff --git 1/packages/shared/src/prime-runtime.ts 2/packages/shared/src/prime-runtime.ts
new file mode 100644
index 0000000..b08b18f
--- /dev/null
+++ 2/packages/shared/src/prime-runtime.ts
@@ -0,0 +1,71 @@
+import { z } from "zod";
+
+/** Maximum single Prime authority, broker request, or newline-delimited receipt in UTF-8 bytes. */
+export const PRIME_RUNTIME_WIRE_LIMIT_BYTES = 16 * 1024 * 1024;
+
+const id = z.string().min(1).max(256);
+const absolutePath = z.string().min(2).max(4096).refine((value) => value.startsWith("/") && !value.includes("\0") && !value.split("/").includes(".."), "Expected a confined absolute path");
+const digest = z.string().regex(/^[a-f0-9]{64}$/);
+const timestamp = z.string().datetime({ offset: true });
+const jsonObject = z.record(z.string(), z.unknown());
+const prompt = z.string().min(1).max(1_000_000);
+
+export const primeRuntimeAuthoritySchema = z.object({
+  version: z.literal(2),
+  operationId: id,
+  turnId: id,
+  identity: z.object({ companyId: id, agentId: id, issueId: id, runId: id, controllerId: id, responsibleUserId: id }).strict(),
+  workspace: z.object({ id, executionWorkspaceId: id, root: absolutePath, realRoot: absolutePath }).strict(),
+  instructions: z.object({ content: z.string(), revision: id.nullable(), sourcePath: absolutePath, sha256: digest }).strict(),
+  prompt,
+  session: z.object({
+    namespace: digest,
+    previous: z.object({ runId: id, primeSessionId: id, checkpoint: id, checkpointDigest: digest, lastReceiptId: id }).strict().nullable(),
+  }).strict(),
+  harness: z.object({ maxSubagentDepth: z.literal(2), maxSubagents: z.literal(4) }).strict(),
+  skills: z.array(z.object({ key: id, versionId: id.nullable(), path: absolutePath, sha256: digest }).strict()),
+  mcp: z.object({ setDigest: digest, gatewayId: id.nullable(), assignmentDigest: digest.nullable(), tools: z.array(z.object({
+    connectionId: id, name: id, description: z.string(), inputSchema: jsonObject,
+    schemaSha256: digest, policy: z.enum(["allow", "approval", "deny"]),
+  }).strict()) }).strict(),
+  localTools: z.tuple([z.object({ name: z.literal("ipython"), policy: z.literal("workspace-write"), inputSchema: jsonObject, schemaSha256: digest }).strict()]),
+  selection: z.object({ connectionId: id, grantId: id, method: z.literal("subscription"), provider: z.literal("openai-codex"), model: id }).strict(),
+  generations: z.object({ controller: id, issue: id, run: id, grant: id, workspace: id, instructions: id, skills: id, tools: id }).strict(),
+  executeDeadlineAt: timestamp,
+  controlDeadlineAt: timestamp,
+  containment: z.object({ profile: z.literal("paperclip-workspace-write-v3"), disableDiscovery: z.literal(true), protectManagedFiles: z.literal(true), isolateCredentials: z.literal(true), forbidAutonomousWork: z.literal(true) }).strict(),
+}).strict();
+export type PrimeRuntimeAuthority = z.infer<typeof primeRuntimeAuthoritySchema>;
+
+export const primeBrokerPayloadSchema = z.discriminatedUnion("method", [
+  z.object({ method: z.literal("provider.catalog") }).strict(),
+  z.object({ method: z.literal("provider.stream"), turnId: id, request: jsonObject }).strict(),
+  z.object({ method: z.literal("provider.status"), targetRequestId: id }).strict(),
+  z.object({ method: z.literal("provider.abort"), targetRequestId: id }).strict(),
+  z.object({ method: z.literal("mcp.tools.list"), connectionId: id }).strict(),
+  z.object({ method: z.literal("mcp.tools.call"), connectionId: id, tool: id, arguments: jsonObject }).strict(),
+  z.object({ method: z.literal("paperclip.request"), httpMethod: z.enum(["GET", "POST", "PATCH", "PUT"]), path: z.string().min(1).max(1024), body: z.unknown().optional() }).strict(),
+  z.object({ method: z.literal("paperclip.finish"), status: z.enum(["blocked", "in_review", "done"]), summary: z.string().min(1).max(20_000) }).strict(),
+  z.object({ method: z.literal("effect.status"), targetRequestId: id }).strict(),
+  z.object({ method: z.literal("operation.stop") }).strict(),
+  z.object({ method: z.literal("operation.status") }).strict(),
+]);
+export const primeBrokerRequestSchema = z.object({ version: z.literal(2), authorityDigest: digest, operationId: id, requestId: id, payload: primeBrokerPayloadSchema }).strict();
+export type PrimeBrokerRequest = z.infer<typeof primeBrokerRequestSchema>;
+export const primeBrokerResultSchema = z.discriminatedUnion("kind", [
+  z.object({ kind: z.literal("reservation"), method: z.enum(["provider.catalog", "provider.stream", "provider.status", "provider.abort", "mcp.tools.list", "mcp.tools.call", "paperclip.request", "paperclip.finish", "effect.status", "operation.stop", "operation.status"]), state: z.enum(["dispatching", "uncertain"]) }).strict(),
+  z.object({ kind: z.literal("catalog"), provider: z.literal("openai-codex"), model: id, available: z.literal(true) }).strict(),
+  z.object({ kind: z.literal("provider"), providerRequestId: id.nullable(), state: z.enum(["accepted", "streaming", "completed", "aborted", "failed", "uncertain"]), usage: jsonObject.nullable() }).strict(),
+  z.object({ kind: z.literal("mcp_tools"), connectionId: id, tools: primeRuntimeAuthoritySchema.shape.mcp.shape.tools }).strict(),
+  z.object({ kind: z.literal("effect"), requestId: id, invocationId: id.nullable(), actionRequestId: id.nullable(), interactionId: id.nullable(), formalApprovalId: id.nullable(), argumentsHash: digest, state: z.enum(["reserved", "awaiting_approval", "executing", "completed", "failed", "uncertain"]), result: z.unknown().nullable() }).strict(),
+  z.object({ kind: z.literal("paperclip"), requestId: id, status: z.number().int().min(200).max(299), body: z.unknown() }).strict(),
+  z.object({ kind: z.literal("finalization"), intentId: id, issueId: id, status: z.enum(["blocked", "in_review", "done"]), summary: z.string().min(1).max(20_000), state: z.literal("recorded") }).strict(),
+  z.object({ kind: z.literal("operation"), fenced: z.boolean(), provider: z.enum(["settled", "uncertain"]), governedActions: z.enum(["settled", "uncertain"]), outstandingEffects: z.number().int().nonnegative() }).strict(),
+]);
+export type PrimeBrokerResult = z.infer<typeof primeBrokerResultSchema>;
+export const primeBrokerFrameSchema = z.discriminatedUnion("kind", [
+  z.object({ version: z.literal(2), requestId: id, sequence: z.number().int().nonnegative(), kind: z.literal("provider_event"), event: jsonObject }).strict(),
+  z.object({ version: z.literal(2), requestId: id, sequence: z.number().int().nonnegative(), kind: z.literal("result"), result: primeBrokerResultSchema }).strict(),
+  z.object({ version: z.literal(2), requestId: id, sequence: z.number().int().nonnegative(), kind: z.literal("error"), error: z.object({ code: id, message: z.string() }).strict() }).strict(),
+]);
+export type PrimeBrokerFrame = z.infer<typeof primeBrokerFrameSchema>;
