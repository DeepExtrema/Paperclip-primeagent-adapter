+  // any native launch. A large tool catalog must fail before accepting model work.
+  if (Buffer.byteLength(JSON.stringify(authority), "utf8") > PRIME_RUNTIME_WIRE_LIMIT_BYTES - 4096)
+    throw new Error("Prime authority exceeds the managed wire limit");
+  const digest = primeDigest(authority);
+  await db.insert(primeRuntimeAuthorities).values({ runId: input.runId, companyId: input.companyId, operationId: input.runId, authority, digest }).onConflictDoNothing();
+  const [persisted] = await db.select().from(primeRuntimeAuthorities).where(eq(primeRuntimeAuthorities.runId, input.runId));
+  if (!persisted || persisted.digest !== digest) throw new Error("Prime run authority already exists with different realization");
+  return { authority, authorityDigest: digest, executeCapability: primePurposeCapability(authority, digest, "execute"), controlCapability: primePurposeCapability(authority, digest, "control") };
+}
