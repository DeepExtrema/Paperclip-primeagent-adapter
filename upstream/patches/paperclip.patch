diff --git 1/server/src/services/prime-workspace-safety.ts 2/server/src/services/prime-workspace-safety.ts
new file mode 100644
index 0000000..c5f0ec7
--- /dev/null
+++ 2/server/src/services/prime-workspace-safety.ts
@@ -0,0 +1,309 @@
+import { and, eq, exists, inArray, isNotNull, isNull, ne, or, sql } from "drizzle-orm";
+import { agents, heartbeatRuns, primeBrokerRequests, primePhysicalWriters, primeRuntimeAuthorities, workspaceRuntimeServices, type Db } from "@paperclipai/db";
+import { primeRuntimeAuthoritySchema } from "@paperclipai/shared";
+import { lstat, realpath, stat } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { readConfigFile } from "../config-file.js";
+import {
+  resolveDefaultBackupDir,
+  resolveDefaultEmbeddedPostgresDir,
+  resolveDefaultLogsDir,
+  resolveDefaultSecretsKeyFilePath,
+  resolveDefaultStorageDir,
+  resolveHomeAwarePath,
+  resolvePaperclipHomeDir,
+  resolvePaperclipInstanceRoot,
+} from "../home-paths.js";
+import { resolvePaperclipConfigPath, resolvePaperclipEnvPath } from "../paths.js";
+
+// An overlap includes either direction: mounting a parent exposes its private children.
+function overlaps(left: string, right: string): boolean {
+  const relative = path.relative(left, right);
+  return relative === "" || (relative !== ".." && !relative.startsWith(`..${path.sep}`) && !path.isAbsolute(relative));
+}
+
+
+export class PrimeWorkspaceAdmissionError extends Error {}
+export class PrimeWorkspaceRequiresReviewError extends PrimeWorkspaceAdmissionError {
+  readonly code = "prime_workspace_requires_review";
+  constructor() {
+    super("Prime workspace provenance requires operator review before host project or Git execution");
+  }
+}
+
+
+/** Serialize every local writer admission so Prime cannot race a second adapter into its root. */
+export async function reservePrimePhysicalWriter(db: Db, runId: string, root: string): Promise<void> {
+  const candidate = await resolveExistingPrefix(root).catch((error: unknown) => {
+    throw new PrimeWorkspaceAdmissionError(error instanceof Error ? error.message : String(error));
+  });
+  await db.transaction(async (tx) => {
+    await tx.execute(sql`select pg_advisory_xact_lock(hashtext('prime_physical_writers'))`);
+    const [current] = await tx.select({
+      status: heartbeatRuns.status, adapterType: agents.adapterType,
+    }).from(heartbeatRuns).innerJoin(agents, eq(agents.id, heartbeatRuns.agentId))
+      .where(eq(heartbeatRuns.id, runId)).for("update");
+    await assertNoHeldPrimeWorkspace(tx as unknown as Db, runId, root, {
+      allowPrimeProvenance: current?.adapterType === "prime_bff",
+    });
+    if (!current || current.status !== "running")
+      throw new Error("Prime physical writer requires a live run");
+    const others = await tx.select({
+      root: primePhysicalWriters.root, prime: primePhysicalWriters.prime,
+    }).from(primePhysicalWriters)
+      .where(ne(primePhysicalWriters.runId, runId));
+    if (others.some((other) => (current.adapterType === "prime_bff" || other.prime) &&
+        (overlaps(candidate, other.root) || overlaps(other.root, candidate))))
+      throw new Error("Workspace is reserved by an active physical writer");
+    if (current.adapterType === "prime_bff") {
+      const services = await tx.select({ cwd: workspaceRuntimeServices.cwd })
+        .from(workspaceRuntimeServices)
+        .where(and(eq(workspaceRuntimeServices.provider, "local_process"),
+          inArray(workspaceRuntimeServices.status, ["provisioning", "starting", "running"])));
+      for (const service of services) {
+        // An active writer without a recorded cwd cannot prove it is disjoint.
+        if (!service.cwd) throw new Error("An active managed runtime has no physical workspace owner");
+        const serviceRoot = await resolveExistingPrefix(service.cwd);
+        if (overlaps(candidate, serviceRoot) || overlaps(serviceRoot, candidate))
+          throw new Error("Workspace overlaps an active managed runtime service");
+      }
+    }
+    // An already-running writer from before reservation rollout has no root
+    // evidence. Do not let it overlap a new Prime by assuming it is elsewhere.
+    const unreserved = await tx.select({
+      adapterType: agents.adapterType,
+    }).from(heartbeatRuns).innerJoin(agents, eq(agents.id, heartbeatRuns.agentId))
+      .leftJoin(primePhysicalWriters, eq(primePhysicalWriters.runId, heartbeatRuns.id))
+      .where(and(ne(heartbeatRuns.id, runId), eq(heartbeatRuns.status, "running"),
+        isNull(primePhysicalWriters.runId)));
+    if (unreserved.some((other) => current.adapterType === "prime_bff" ||
+        other.adapterType === "prime_bff"))
+      throw new Error("Physical writer ownership is unproven while another run is active");
+    await tx.insert(primePhysicalWriters).values({
+      runId, root: candidate, prime: current.adapterType === "prime_bff",
+    }).onConflictDoNothing();
+  }).catch((error: unknown) => {
+    if (error instanceof PrimeWorkspaceRequiresReviewError) throw error;
+    throw new PrimeWorkspaceAdmissionError(error instanceof Error ? error.message : String(error));
+  });
+}
+
+/** Durable exclusion for unresolved Prime effects, including after the issue lock is released. */
+export async function assertNoHeldPrimeWorkspace(
+  db: Db, runId: string | null, root: string,
+  options?: { allowPrimeProvenance?: boolean },
+): Promise<void> {
+  const candidate = await resolveExistingPrefix(root);
+  await assertPrimeQuarantineBoundary(root, candidate);
+  const unresolved = db.select({ requestId: primeBrokerRequests.requestId })
+    .from(primeBrokerRequests)
+    .where(and(eq(primeBrokerRequests.runId, primeRuntimeAuthorities.runId),
+      or(eq(primeBrokerRequests.method, "provider.stream"),
+        eq(primeBrokerRequests.method, "mcp.tools.call"),
+        eq(primeBrokerRequests.method, "paperclip.request"),
+        eq(primeBrokerRequests.method, "paperclip.finish")),
+      ne(primeBrokerRequests.state, "completed"),
+      ne(primeBrokerRequests.state, "failed"),
+      ne(primeBrokerRequests.state, "aborted")));
+  const rows = await db.select({
+    runId: primeRuntimeAuthorities.runId,
+    authority: primeRuntimeAuthorities.authority,
+  }).from(primeRuntimeAuthorities)
+    .where(and(runId === null ? undefined : ne(primeRuntimeAuthorities.runId, runId),
+      or(eq(primeRuntimeAuthorities.fenced, "uncertain"),
+        ne(primeRuntimeAuthorities.providerSettlement, "settled"),
+        ne(primeRuntimeAuthorities.governedSettlement, "settled"),
+        and(isNotNull(primeRuntimeAuthorities.finalizationReceiptId),
+          isNull(primeRuntimeAuthorities.finalizationAppliedAt)),
+        ne(primeRuntimeAuthorities.workerSettlement, "settled"),
+        exists(unresolved))));
+  for (const row of rows) {
+    // Historical authorities are quarantined; only the new v2 contract can fence a new run.
+    if (row.authority.version !== 2) continue;
+    const held = primeRuntimeAuthoritySchema.parse(row.authority);
+    if (overlaps(candidate, held.workspace.realRoot) ||
+      overlaps(held.workspace.realRoot, candidate))
+      throw new Error("Workspace overlaps an unresolved Prime run; recovery is required");
+  }
+  const livePrimeWriters = await db.select({ root: primePhysicalWriters.root })
+    .from(primePhysicalWriters).where(and(eq(primePhysicalWriters.prime, true),
+      runId === null ? undefined : ne(primePhysicalWriters.runId, runId)));
+  if (livePrimeWriters.some((writer) => overlaps(candidate, writer.root) ||
+      overlaps(writer.root, candidate)))
+    throw new Error("Workspace overlaps an unsettled Prime physical writer");
+  if (options?.allowPrimeProvenance) return;
+  // The authority's canonical root is immutable after registration. Settling
+  // the physical writer permits another Prime run, not automatic host Git or
+  // shell execution of files that the previous Prime worker could edit.
+  const provenance = await db.select({ authority: primeRuntimeAuthorities.authority })
+    .from(primeRuntimeAuthorities)
+    .where(and(runId === null ? undefined : ne(primeRuntimeAuthorities.runId, runId),
+      sql`${primeRuntimeAuthorities.authority}->>'version' = '2'`,
+      sql`(
+        starts_with(${primeRuntimeAuthorities.authority}->'workspace'->>'realRoot', ${`${candidate}/`})
+        or starts_with(${candidate}, (${primeRuntimeAuthorities.authority}->'workspace'->>'realRoot') || '/')
+        or ${primeRuntimeAuthorities.authority}->'workspace'->>'realRoot' = ${candidate}
+      )`));
+  for (const row of provenance) {
+    const previous = primeRuntimeAuthoritySchema.parse(row.authority);
+    if (overlaps(candidate, previous.workspace.realRoot) ||
+      overlaps(previous.workspace.realRoot, candidate))
+      throw new PrimeWorkspaceRequiresReviewError();
+  }
+}
+/** Resolve existing symlinks even when the final protected file/directory has not been created yet. */
+async function resolveExistingPrefix(value: string): Promise<string> {
+  const absolute = path.resolve(value);
+  let ancestor = absolute;
+  const missing: string[] = [];
+  while (true) {
+    try {
+      await lstat(ancestor);
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+      const parent = path.dirname(ancestor);
+      if (parent === ancestor) throw error;
+      missing.push(path.basename(ancestor));
+      ancestor = parent;
+      continue;
+    }
+    // A dangling symlink is not a missing leaf; realpath must fail closed.
+    return path.resolve(await realpath(ancestor), ...missing.reverse());
+  }
+}
+
+/** Operator-owned quarantine bridges original held workspaces without importing old authority. */
+async function assertPrimeQuarantineBoundary(root: string, canonicalRoot: string): Promise<void> {
+  const raw = process.env.PAPERCLIP_PRIME_QUARANTINE_ROOTS;
+  if (raw === undefined) return;
+  let entries: unknown;
+  try { entries = JSON.parse(raw); }
+  catch { throw new Error("PAPERCLIP_PRIME_QUARANTINE_ROOTS must be a JSON array of absolute paths"); }
+  if (!Array.isArray(entries) || entries.some((entry) =>
+    typeof entry !== "string" || !entry || !path.isAbsolute(entry) ||
+    entry.includes("\0") || entry.split(path.sep).includes("..") ||
+    path.resolve(entry) === path.parse(entry).root))
+    throw new Error("PAPERCLIP_PRIME_QUARANTINE_ROOTS must be a JSON array of absolute paths");
+  const lexicalRoot = path.resolve(root);
+  for (const entry of entries as string[]) {
+    const lexicalHeld = path.resolve(entry);
+    const canonicalHeld = await resolveExistingPrefix(lexicalHeld);
+    if (overlaps(lexicalRoot, lexicalHeld) || overlaps(lexicalHeld, lexicalRoot) ||
+      overlaps(canonicalRoot, canonicalHeld) || overlaps(canonicalHeld, canonicalRoot))
+      throw new Error("Workspace overlaps an operator-quarantined Prime root");
+  }
+}
+
+
+/**
+ * Refuse known host private/system storage as either the workspace itself or anything it exposes.
+ * This path gate is in addition to, not a replacement for, the worker's read/write mount policy.
+ */
+export async function assertSafePrimeWorkspace(root: string): Promise<void> {
+  if (!root || !path.isAbsolute(root)) throw new Error("Prime workspace must be an absolute existing directory");
+  const absoluteRoot = path.resolve(root);
+  if (absoluteRoot === path.parse(absoluteRoot).root) throw new Error("Prime workspace cannot be a filesystem root");
+  if (!(await stat(absoluteRoot)).isDirectory()) throw new Error("Prime workspace must be a directory");
+  const canonicalRoot = await realpath(absoluteRoot);
+  // Managed AI connections materialize credential files in mkdtemp(\"paperclip-ai-...\")
+  // under os.tmpdir(), not under the instance root. Do not expose those homes or /tmp itself.
+  const tmp = path.resolve(os.tmpdir());
+  const canonicalTmp = await resolveExistingPrefix(tmp);
+  for (const [candidate, tempRoot] of [[absoluteRoot, tmp], [canonicalRoot, canonicalTmp]]) {
+    const relative = path.relative(tempRoot, candidate);
+    if (relative === "" || (!relative.startsWith(`..${path.sep}`) && relative !== ".." &&
+      !path.isAbsolute(relative) && relative.split(path.sep)[0]?.startsWith("paperclip-ai-"))) {
+      throw new Error("Prime workspace overlaps protected host storage");
+    }
+  }
+
+  const instance = resolvePaperclipInstanceRoot();
+  const home = resolvePaperclipHomeDir();
+  const configPath = resolvePaperclipConfigPath();
+  const config = readConfigFile();
+  const operatorHome = os.homedir();
+  const protectedPaths = [
+    "/etc", "/proc", "/sys", "/dev", "/run", "/boot", "/usr", "/bin",
+    "/sbin", "/lib", "/lib64", "/var", "/opt", "/root",
+    path.join(operatorHome, ".ssh"),
+    path.join(operatorHome, ".gnupg"),
+    path.join(operatorHome, ".aws"),
+    path.join(operatorHome, ".azure"),
+    path.join(operatorHome, ".config"),
+    path.join(operatorHome, ".docker"),
+    path.join(operatorHome, ".kube"),
+    path.join(operatorHome, ".codex"),
+    path.join(operatorHome, ".prime"), // Prime CLI config.json and agent/auth.json.
+    path.join(operatorHome, ".omp"),
+    path.join(operatorHome, ".claude"),
+    path.join(operatorHome, ".gemini"),
+    path.join(operatorHome, ".grok"),
+    path.join(operatorHome, ".pi"), // Native SDK OAuth fallback.
+    path.join(operatorHome, ".local", "share", "prime"),
+    path.join(operatorHome, ".local", "share", "keyrings"),
+    path.join(operatorHome, ".local", "share", "opencode"),
+    path.join(operatorHome, ".netrc"),
+    path.join(operatorHome, ".npmrc"),
+    path.join(operatorHome, ".pypirc"),
+    path.join(home, "context.json"),
+    path.join(instance, "secrets"),
+    path.join(instance, "companies"), // Managed account/agent credential homes.
+    path.join(instance, "ai-local-logins"),
+    resolveDefaultEmbeddedPostgresDir(),
+    resolveDefaultBackupDir(),
+    resolveDefaultStorageDir(),
+    resolveDefaultLogsDir(),
+    resolveDefaultSecretsKeyFilePath(),
+    resolvePaperclipConfigPath(),
+    resolvePaperclipEnvPath(),
+    configPath,
+    resolvePaperclipEnvPath(configPath),
+    ...[
+      config?.database.embeddedPostgresDataDir,
+      config?.database.backup.dir,
+      config?.storage.localDisk.baseDir,
+      config?.logging.logDir,
+      config?.secrets.localEncrypted.keyFilePath,
+    ].filter((value): value is string => Boolean(value)).map(resolveHomeAwarePath),
+    ...[
+      "PAPERCLIP_SECRETS_MASTER_KEY_FILE",
+      "PAPERCLIP_STORAGE_LOCAL_DIR",
+      "PAPERCLIP_DB_BACKUP_DIR",
+      "PAPERCLIP_LOG_DIR",
+      "PAPERCLIP_CONTEXT",
+      "CODEX_HOME",
+      "PRIME_AGENT_CODING_AGENT_DIR",
+      "PI_CODING_AGENT_DIR",
+      "CLAUDE_CONFIG_DIR",
+      "GROK_HOME",
+      "OPENCODE_CONFIG_DIR",
+      "OPENCODE_CONFIG",
+      "AWS_SHARED_CREDENTIALS_FILE",
+      "AWS_CONFIG_FILE",
+      "GOOGLE_APPLICATION_CREDENTIALS",
+      "CLOUDSDK_CONFIG",
+      "AZURE_CONFIG_DIR",
+      "DOCKER_CONFIG",
+      "GH_CONFIG_DIR",
+      "GNUPGHOME",
+      "XDG_CONFIG_HOME",
+    ].map((name) => {
+      const value = process.env[name]?.trim();
+      return value ? resolveHomeAwarePath(value) : undefined;
+    }).filter((value): value is string => value !== undefined),
+    ...(process.env.KUBECONFIG?.split(path.delimiter) ?? []).filter(Boolean).map(resolveHomeAwarePath),
+  ];
+  // Canonicalize every protected location independently: a missing secret file can live under
+  // a symlinked parent, and a symlinked workspace may point into an existing credential home.
+  for (const protectedPath of new Set(protectedPaths)) {
+    const lexical = path.resolve(protectedPath);
+    const canonical = await resolveExistingPrefix(lexical);
+    if (
+      overlaps(absoluteRoot, lexical) || overlaps(lexical, absoluteRoot) ||
+      overlaps(canonicalRoot, canonical) || overlaps(canonical, canonicalRoot)
+    ) {
+      throw new Error("Prime workspace overlaps protected host storage");
+    }
+  }
+}
