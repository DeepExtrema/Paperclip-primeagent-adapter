+  sql<string>`encode(sha256(convert_to((${value})::text, 'UTF8')), 'hex')`;
+
+/**
+ * Build a deterministic JSONB row set inside the deciding statement. No table
+ * contents, credential references or policy documents leave PostgreSQL.
+ */
+const sqlRows = (table: AnyPgTable, companyId: string, value: SQL) =>
+  sql`(select coalesce(jsonb_agg(${value} order by snapshot_row.id), '[]'::jsonb)
+    from ${table} snapshot_row where snapshot_row.company_id = ${companyId})`;
+
+type MutableGenerations = PrimeRuntimeAuthority["generations"];
+type SqlDecision = MutableGenerations & { eligible: boolean };
+
+/**
+ * The statement snapshot is the execute linearization point. Sampling before
+ * the asynchronous account/assignment resolver and comparing afterward also
+ * fences those resolvers against reading a mixture of database generations.
+ * SQL-clock ownership is evaluated here, not at the beginning of an I/O tail.
+ */
+async function coherentMutableDecision(db: Db, authority: PrimeRuntimeAuthority, selectedConfig?: Record<string, unknown>, selectedBinding?: unknown): Promise<SqlDecision> {
+  const { identity, workspace, selection, mcp } = authority;
+  const companyId = identity.companyId;
+  const memberships = sqlRows(companyMemberships, companyId, sql`jsonb_build_array(snapshot_row.id, snapshot_row.principal_type,
+    snapshot_row.principal_id, snapshot_row.status, snapshot_row.membership_role)`);
+  const audience = sqlRows(connectionGrantMembers, companyId, sql`jsonb_build_array(snapshot_row.id, snapshot_row.grant_id,
+    snapshot_row.subject_type, snapshot_row.subject_id)`);
+  const defaults = sqlRows(aiProviderDefaults, companyId, sql`jsonb_build_array(snapshot_row.id, snapshot_row.user_id,
+    snapshot_row.provider, snapshot_row.grant_id)`);
+  const installs = sqlRows(toolConnectionInstalls, companyId, sql`jsonb_build_array(snapshot_row.id,
+    snapshot_row.connection_id, snapshot_row.target_type, snapshot_row.target_id)`);
+  const connections = sqlRows(toolConnections, companyId, sql`to_jsonb(snapshot_row)
+    - 'health_message' - 'health_checked_at' - 'last_health_at'
+    - 'last_catalog_refresh_at' - 'last_error' - 'updated_at'`);
+  const grants = sqlRows(connectionGrants, companyId, sql`jsonb_build_array(snapshot_row.id,
+    snapshot_row.connection_id, snapshot_row.kind, snapshot_row.subject_user_id, snapshot_row.subject_agent_id,
+    snapshot_row.status, snapshot_row.provider_tenant - 'oauth', snapshot_row.credential_secret_refs,
+    snapshot_row.external_credential)`);
