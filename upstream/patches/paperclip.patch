+import { randomUUID } from "node:crypto";
+import { mkdtemp, mkdir, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";
+import { agents, companies, createDb, heartbeatRuns, primePhysicalWriters } from "@paperclipai/db";
+import { getEmbeddedPostgresTestSupport, startEmbeddedPostgresTestDatabase } from "../__tests__/helpers/embedded-postgres.js";
+import { assertNoHeldPrimeWorkspace } from "./prime-workspace-safety.js";
+
+const support = await getEmbeddedPostgresTestSupport();
+const describePostgres = support.supported ? describe : describe.skip;
+if (!support.supported) console.warn(`Skipping Prime workspace PostgreSQL tests: ${support.reason}`);
+
+describePostgres("Prime workspace checks without a run owner", () => {
+  let database: Awaited<ReturnType<typeof startEmbeddedPostgresTestDatabase>>;
+  let db: ReturnType<typeof createDb>;
+  let root: string;
+
+  beforeAll(async () => {
+    vi.stubEnv("PAPERCLIP_PRIME_QUARANTINE_ROOTS", "[]");
+    database = await startEmbeddedPostgresTestDatabase("paperclip-prime-board-workspace-");
+    db = createDb(database.connectionString);
+    root = await mkdtemp(path.join(tmpdir(), "prime-board-workspace-"));
+    await Promise.all([mkdir(path.join(root, "held")), mkdir(path.join(root, "disjoint"))]);
+  }, 20_000);
+
+  afterAll(async () => {
+    await db?.$client.end({ timeout: 1 });
+    await database?.cleanup();
+    if (root) await rm(root, { recursive: true, force: true });
+    vi.unstubAllEnvs();
+  });
+
+  it("excludes every overlapping writer while permitting an unrelated Board operation", async () => {
+    const companyId = randomUUID(), agentId = randomUUID(), runId = randomUUID();
+    const held = path.join(root, "held");
+    await db.insert(companies).values({ id: companyId, name: "Prime guard fixture", issuePrefix: "PGF" });
+    await db.insert(agents).values({ id: agentId, companyId, name: "Prime fixture", role: "general", adapterType: "prime_bff" });
+    await db.insert(heartbeatRuns).values({ id: runId, companyId, agentId, status: "running" });
+    await db.insert(primePhysicalWriters).values({ runId, root: held, prime: true });
+
+    for (const candidate of [held, path.join(held, "child"), root]) {
+      await expect(assertNoHeldPrimeWorkspace(db, null, candidate)).rejects.toThrow();
+    }
+    await expect(assertNoHeldPrimeWorkspace(db, null, path.join(root, "disjoint"))).resolves.toBeUndefined();
+  });
+});
