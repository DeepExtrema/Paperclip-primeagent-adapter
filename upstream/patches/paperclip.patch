+import { mkdtemp, mkdir, rm, stat, symlink } from "node:fs/promises";
+import { randomUUID } from "node:crypto";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { sql } from "drizzle-orm";
+import { primeRuntimeAuthoritySchema } from "@paperclipai/shared";
+import type { Db } from "@paperclipai/db";
+import { PrimeWorkspaceAdmissionError, PrimeWorkspaceRequiresReviewError, assertNoHeldPrimeWorkspace, reservePrimePhysicalWriter } from "./prime-workspace-safety.js";
+import { ensureManagedProjectWorkspace } from "./heartbeat.js";
+
+function boundedDb(
+  rows: Array<{ runId: string; authority: Record<string, unknown> }>,
+  physicalRoots: string[] = [],
+  settledAuthorities: Array<{ authority: Record<string, unknown> }> = [],
+) {
+  let selections = 0;
+  const db = {
+    select() {
+      selections += 1;
+      if (selections === 1)
+        return { from: () => ({ where: () => sql`select 1` }) };
+      if (selections === 2) return { from: () => ({ where: async () => rows }) };
+      if (selections === 3)
+        return { from: () => ({ where: async () => physicalRoots.map((root) => ({ root })) }) };
+      return { from: () => ({ where: async () => settledAuthorities }) };
+    },
+  } as unknown as Db;
+  return { db };
+}
+
+function admissionDb(input: {
+  currentAdapter: string;
+  active: Array<{ root: string; prime: boolean }>;
+  runtimeServices?: Array<{ cwd: string | null }>;
+  settledPrimeRoots?: string[];
+}) {
+  let selections = 0;
+  const tx = {
+    execute: async () => [],
+    select() {
+      selections += 1;
+      if (selections === 1) return { from: () => ({ innerJoin: () => ({
+        where: () => ({ for: async () => [{ status: "running", adapterType: input.currentAdapter }] }),
+      }) }) };
+      if (selections === 2) return { from: () => ({ where: () => sql`select 1` }) };
+      if (selections === 3 || selections === 4)
+        return { from: () => ({ where: async () => [] }) };
+      if (selections === 5 && input.currentAdapter !== "prime_bff")
+        return { from: () => ({ where: async () =>
+          (input.settledPrimeRoots ?? []).map((root) => ({ authority: heldAuthority(root) })) }) };
+      const activeSelection = input.currentAdapter === "prime_bff" ? 5 : 6;
+      if (selections === activeSelection) return { from: () => ({
+        where: async () => input.active,
+      }) };
+      if (selections === activeSelection + 1 && input.currentAdapter === "prime_bff")
+        return { from: () => ({ where: async () => input.runtimeServices ?? [] }) };
+      return { from: () => ({ innerJoin: () => ({ leftJoin: () => ({
+        where: async () => [],
+      }) }) }) };
+    },
+    insert: () => ({ values: () => ({ onConflictDoNothing: async () => {} }) }),
+  };
+  return { transaction: async (effect: (value: typeof tx) => Promise<unknown>) => effect(tx) } as unknown as Db;
+}
+
+function heldAuthority(root: string) {
+  const digest = "0".repeat(64);
+  return primeRuntimeAuthoritySchema.parse({
+    version: 2, operationId: "other-run", turnId: "other-run",
+    identity: { companyId: "other-company", agentId: "other-agent", issueId: "other-issue",
+      runId: "other-run", controllerId: "other-controller", responsibleUserId: "other-user" },
+    workspace: { id: "other-workspace", executionWorkspaceId: "other-execution", root, realRoot: root },
+    instructions: { content: "Managed instructions", revision: null, sourcePath: path.join(root, "AGENTS.md"), sha256: digest },
+    prompt: "Managed task", session: { namespace: digest, previous: null },
+    harness: { maxSubagentDepth: 2, maxSubagents: 4 }, skills: [],
+    mcp: { setDigest: digest, gatewayId: null, assignmentDigest: null, tools: [] },
+    localTools: [{ name: "ipython", policy: "workspace-write", inputSchema: {}, schemaSha256: digest }],
+    selection: { connectionId: "other-connection", grantId: "other-grant", method: "subscription",
+      provider: "openai-codex", model: "exact-model" },
+    generations: { controller: "1", issue: "1", run: "1", grant: "1", workspace: "1",
+      instructions: "1", skills: "1", tools: "1" },
+    executeDeadlineAt: new Date(Date.now() + 60_000).toISOString(),
+    controlDeadlineAt: new Date(Date.now() + 60_000).toISOString(),
+    containment: { profile: "paperclip-workspace-write-v3", disableDiscovery: true,
+      protectManagedFiles: true, isolateCredentials: true, forbidAutonomousWork: true },
+  });
+}
+
+describe("Prime physical workspace exclusion", () => {
+  const originalQuarantine = process.env.PAPERCLIP_PRIME_QUARANTINE_ROOTS;
+  let directory: string;
+  beforeEach(async () => {
+    directory = await mkdtemp(path.join(tmpdir(), "paperclip-prime-boundary-"));
+    delete process.env.PAPERCLIP_PRIME_QUARANTINE_ROOTS;
+  });
+  afterEach(async () => {
+    if (originalQuarantine === undefined) delete process.env.PAPERCLIP_PRIME_QUARANTINE_ROOTS;
+    else process.env.PAPERCLIP_PRIME_QUARANTINE_ROOTS = originalQuarantine;
+    await rm(directory, { recursive: true, force: true });
+  });
+
+  it("keeps an unsettled physical writer held independently of run status and error code", async () => {
+    const root = path.join(directory, "root");
+    await mkdir(root);
+    const held = boundedDb([], [root]);
+    await expect(assertNoHeldPrimeWorkspace(held.db, "new-run", path.join(root, "child")))
+      .rejects.toThrow("Workspace overlaps an unsettled Prime physical writer");
+  });
+
+  it("rejects malformed or relative operator quarantine lists before querying authorities", async () => {
+    const workspace = path.join(directory, "workspace");
+    await mkdir(workspace);
+    for (const raw of ["", "{}", '["relative/path"]', '["/valid",42]', '["/path/../other"]']) {
+      process.env.PAPERCLIP_PRIME_QUARANTINE_ROOTS = raw;
+      await expect(assertNoHeldPrimeWorkspace({} as Db, "current-run", workspace))
+        .rejects.toThrow("PAPERCLIP_PRIME_QUARANTINE_ROOTS must be a JSON array of absolute paths");
+    }
+  });
+
+  it("canonicalizes symlinked quarantine roots and permits unrelated siblings", async () => {
+    const held = path.join(directory, "historical");
+    const candidate = path.join(held, "nested");
+    const unrelated = path.join(directory, "unrelated");
+    const alias = path.join(directory, "alias");
+    await mkdir(candidate, { recursive: true });
+    await mkdir(unrelated);
+    await symlink(held, alias);
+    process.env.PAPERCLIP_PRIME_QUARANTINE_ROOTS = JSON.stringify([alias]);
+    await expect(assertNoHeldPrimeWorkspace({} as Db, "current-run", candidate))
+      .rejects.toThrow("Workspace overlaps an operator-quarantined Prime root");
+    await expect(assertNoHeldPrimeWorkspace(boundedDb([]).db, "current-run", unrelated))
+      .resolves.toBeUndefined();
+  });
+
+  it("checks the origin-selected managed checkout before clone or mkdir", async () => {
+    let selectedPath: string | null = null;
+    await expect(ensureManagedProjectWorkspace({
+      companyId: randomUUID(), projectId: randomUUID(), repoUrl: null,
+      beforeMaterialize: async (cwd) => {
+        selectedPath = cwd;
+        throw new PrimeWorkspaceAdmissionError("Physical writer denied managed checkout");
+      },
+    })).rejects.toThrow("Physical writer denied managed checkout");
+    expect(selectedPath).not.toBeNull();
+    expect(await stat(selectedPath!).catch(() => null)).toBeNull();
+  });
+
+  it("rejects automatic managed checkout creation for a preprovisioned Prime profile", async () => {
+    let materialized = false;
+    await expect(ensureManagedProjectWorkspace({
+      companyId: randomUUID(), projectId: randomUUID(), repoUrl: null,
+      requirePreprovisioned: true,
+      beforeMaterialize: async () => { materialized = true; },
+    })).rejects.toThrow("Prime requires an existing preprovisioned workspace");
+    expect(materialized).toBe(false);
+  });
+
+  it("refuses host execution on settled Prime provenance while preserving Prime reuse and unrelated roots", async () => {
+    const primeRoot = path.join(directory, "prime");
+    const otherRoot = path.join(directory, "unrelated");
+    await mkdir(primeRoot);
+    await mkdir(otherRoot);
+    const settled = boundedDb([], [], [{ authority: heldAuthority(primeRoot) }]);
+    await expect(assertNoHeldPrimeWorkspace(settled.db, "host-run", path.join(primeRoot, "child")))
+      .rejects.toBeInstanceOf(PrimeWorkspaceRequiresReviewError);
+    await expect(assertNoHeldPrimeWorkspace(
+      boundedDb([], [], [{ authority: heldAuthority(primeRoot) }]).db,
+      "prime-run", primeRoot, { allowPrimeProvenance: true },
+    )).resolves.toBeUndefined();
+    await expect(assertNoHeldPrimeWorkspace(
+      boundedDb([], [], [{ authority: heldAuthority(primeRoot) }]).db,
+      "host-run", otherRoot,
+    )).resolves.toBeUndefined();
+    await expect(reservePrimePhysicalWriter(
+      admissionDb({ currentAdapter: "codex", active: [], settledPrimeRoots: [primeRoot] }),
+      "host-run", path.join(primeRoot, "child"),
+    )).rejects.toBeInstanceOf(PrimeWorkspaceRequiresReviewError);
+  });
+  it("matches settled provenance through symlink aliases and enclosing host roots", async () => {
+    const primeRoot = path.join(directory, "prime");
+    const alias = path.join(directory, "alias");
+    await mkdir(primeRoot);
+    await symlink(primeRoot, alias);
+    await expect(assertNoHeldPrimeWorkspace(
+      boundedDb([], [], [{ authority: heldAuthority(primeRoot) }]).db,
+      "host-run", path.join(alias, "child"),
+    )).rejects.toBeInstanceOf(PrimeWorkspaceRequiresReviewError);
+    await expect(assertNoHeldPrimeWorkspace(
+      boundedDb([], [], [{ authority: heldAuthority(primeRoot) }]).db,
+      "host-run", directory,
+    )).rejects.toBeInstanceOf(PrimeWorkspaceRequiresReviewError);
+  });
+
+
+  it("reserves overlapping active writers only when either run is Prime", async () => {
+    const root = path.join(directory, "root");
+    const child = path.join(root, "new-worktree");
+    await mkdir(root);
+    await expect(reservePrimePhysicalWriter(
+      admissionDb({ currentAdapter: "prime_bff", active: [{ root, prime: false }] }),
